    <scope doc="# Convert GNU texinfo files into HTML, one file per node.# Based on Texinfo 2.14. # Usage: texi2html [-d] [-d] [-c] inputfile outputdirectory # The input file must be a complete texinfo file, e.g. emacs.texi. # This creates many files (one per info node) in the output directory, # overwriting existing files of the same name.  All files created have # &quot;.html&quot; as their extension." ilk="blob" lang="Python3" name="Tools.Scripts.texi2html">
