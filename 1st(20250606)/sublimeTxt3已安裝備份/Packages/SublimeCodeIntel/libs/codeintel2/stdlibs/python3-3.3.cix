          <variable citdl="_split()" line="293" name="chunks" />
          <variable citdl="_munge_whitespace()" ilk="argument" name="text" />
        </scope>
        <scope doc="Wrap a sequence of text chunks and return a list of lines of&#10;length 'self.width' or less. (If 'break_long_words' is&#10;false, some lines may be longer than this.)  Chunks&#10;correspond roughly to words and the whitespace between them:&#10;each chunk is indivisible (modulo 'break_long_words'), but a&#10;line break can come between any two chunks." ilk="function" line="210" lineend="278" name="_wrap_chunks" returns="list" signature="_wrap_chunks(chunks : [string]) -&gt; [string]">
