        <scope doc="Return the next widget in the focus order which&#10;followswidget which has currently the focus. The focus order&#10;first goes to the next child, then to the children of the&#10;child recursively and then to the next sibling which is&#10;higher in the stacking order." ilk="function" name="tk_focusNext" signature="tk_focusNext(self)" />
