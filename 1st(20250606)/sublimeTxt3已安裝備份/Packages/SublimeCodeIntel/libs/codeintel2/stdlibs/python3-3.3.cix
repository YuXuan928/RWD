        <scope doc="Set the negative aliases for this option&#10;parser.'negative_alias' should be a dictionary mapping&#10;option names to option names, both the key and value must&#10;already be defined in the option table." ilk="function" name="set_negative_aliases" signature="set_negative_aliases(self, negative_alias)" />
        <scope ilk="function" name="_check_alias_dict" signature="_check_alias_dict(self, aliases, what)" />
