        <scope doc="Add tag NEWTAG to all items in the rectangle definedby&#10;X1,Y1,X2,Y2." ilk="function" name="addtag_enclosed" signature="addtag_enclosed(self, newtag, x1, y1, x2, y2)" />
        <scope doc="Remember the current X, Y coordinates." ilk="function" name="scan_mark" signature="scan_mark(self, x, y)" />
