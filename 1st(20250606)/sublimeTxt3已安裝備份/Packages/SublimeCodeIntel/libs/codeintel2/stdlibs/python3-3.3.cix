      <scope doc="Execute file with arguments from args in a subprocess with&#10;the supplied environment. If mode == P_NOWAIT return the pid&#10;of the process." ilk="function" name="spawnle" returns="int" signature="spawnle(mode, file, *args, env) -&gt; integer" />
