      <scope doc="Read a keypress and return the resulting character as a byte&#10;string. Nothing is echoed to the console." ilk="function" name="getch" signature="getch() -&gt; key character" />
      <scope doc="Similar to getch(), but the keypress will be echoed if it&#10;represents a printable character." ilk="function" name="getche" signature="getche() -&gt; key character" />
      <scope doc="Wide char variant of getch(), returning a Unicode value." ilk="function" name="getwch" returns="unicode" signature="getwch() -&gt; Unicode key character" />
      <scope doc="Wide char variant of getche(), returning a Unicode value." ilk="function" name="getwche" returns="unicode" signature="getwche() -&gt; Unicode key character" />
