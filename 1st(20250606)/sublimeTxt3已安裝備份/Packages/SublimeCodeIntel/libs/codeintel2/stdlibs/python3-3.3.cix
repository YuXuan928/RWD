      <scope attributes="protected __hidden__" doc="Convenience function to format and return a key=value pair.&#10;&#10;This will quote the value if needed or if quote is true.  If value is a&#10;three tuple (charset, language, value), it will be encoded according&#10;to RFC2231 rules.  If it contains non-ascii characters it will likewise&#10;be encoded according to RFC2231 rules, using the utf-8 charset and&#10;a null language." ilk="function" line="40" lineend="72" name="_formatparam" returns="tuple" signature="_formatparam(param, value=None, quote=True)">
