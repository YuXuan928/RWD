        <scope doc="Return B centered in a string of length width. Padding is&#10;done using the specified fill character (default is a&#10;space)." ilk="function" name="center" signature="B.center(width[, fillchar]) -&gt; copy of B" />
        <scope doc="Return the highest index in B where substring sub is found,&#10;such that sub is contained within B[start:end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="rfind" returns="int" signature="B.rfind(sub[, start[, end]]) -&gt; int" />
