        <scope doc="Constructs Signature from the given list of Parameterobjects&#10;and 'return_annotation'. All arguments are optional." ilk="function" name="__init__" signature="__init__(self, parameters=None, *, return_annotation=&lt;class 'Lib.inspect._empty'&gt;, __validate_parameters__=True)" />
