      <scope doc="Import a module. Because this function is meant for use by&#10;the Python interpreter and not for general use it is better&#10;to use importlib.import_module() to programmatically import&#10;a module." ilk="function" name="__import__" returns="module" signature="__import__(name, globals={}, locals={}, fromlist=[], level=-1) -&gt; module" />
      <scope doc="Return the absolute value of the argument." ilk="function" name="abs" returns="int" signature="abs(number) -&gt; number" />
