        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
      </scope>
      <scope classrefs="object" doc="bytearray(iterable_of_ints) -&gt; bytearraybytearray(string, encoding[, errors]) -&gt; bytearray bytearray(bytes_or_buffer) -&gt; mutable copy of bytes_or_buffer bytearray(int) -&gt; bytes array of size given by the parameter initialized with null bytes bytearray() -&gt; empty bytes array  Construct an mutable bytearray object from: - an iterable yielding integers in range(256) - a text string encoded using the specified encoding - a bytes or a buffer object - any object implementing the buffer API." ilk="class" name="bytearray">
        <scope doc="x.__le__(y) &lt;==&gt; x&lt;=y" ilk="function" name="__le__" signature="x.__le__(y) &lt;==&gt; x&lt;=y" />
        <scope doc="x.__ne__(y) &lt;==&gt; x!=y" ilk="function" name="__ne__" signature="x.__ne__(y) &lt;==&gt; x!=y" />
        <scope doc="Return a titlecased version of B, i.e. ASCII words start&#10;with uppercase characters, all remaining cased characters&#10;have lowercase." ilk="function" name="title" signature="B.title() -&gt; copy of B" />
        <scope doc="Return True if all cased characters in B are uppercase and&#10;there is at least one cased character in B, False otherwise." ilk="function" name="isupper" returns="bool" signature="B.isupper() -&gt; bool" />
        <scope doc="x.__getitem__(y) &lt;==&gt; x[y]" ilk="function" name="__getitem__" signature="x.__getitem__(y) &lt;==&gt; x[y]" />
        <scope doc="Return True if all characters in B are digits and there is&#10;at least one character in B, False otherwise." ilk="function" name="isdigit" returns="bool" signature="B.isdigit() -&gt; bool" />
        <scope doc="Insert a single item into the bytearray before the given&#10;index." ilk="function" name="insert" signature="B.insert(index, int) -&gt; None" />
        <scope doc="x.__eq__(y) &lt;==&gt; x==y" ilk="function" name="__eq__" signature="x.__eq__(y) &lt;==&gt; x==y" />
        <scope doc="Returns the size of B in memory, in bytes" ilk="function" name="__sizeof__" returns="int" signature="B.__sizeof__() -&gt; int" />
        <scope doc="Strip trailing bytes contained in the argument and return&#10;the result as a new bytearray. If the argument is omitted,&#10;strip trailing ASCII whitespace." ilk="function" name="rstrip" signature="B.rstrip([bytes]) -&gt; bytearray" />
        <scope doc="x.__delitem__(y) &lt;==&gt; del x[y]" ilk="function" name="__delitem__" signature="x.__delitem__(y) &lt;==&gt; del x[y]" />
