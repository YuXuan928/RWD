      <scope classrefs="CCompilerError" doc="Failure to link one or more C/C++ object files into an executableor shared library file." ilk="class" name="LinkError" />
      <scope classrefs="CCompilerError" doc="Failure to preprocess one or more C/C++ files." ilk="class" name="PreprocessError" />
