        <scope doc="Pack a widget in the parent widget." ilk="function" name="configure" signature="configure(self, cnf={}, **kw)" />
        <scope doc="Return information about the packing optionsfor this widget." ilk="function" name="pack_info" signature="pack_info(self)" />
