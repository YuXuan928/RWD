      <scope doc="Parse the '227' response for a PASV request.Raises&#10;error_proto if it does not contain '(h1,h2,h3,h4,p1,p2)'&#10;Return ('host.addr.as.numbers', port#) tuple." ilk="function" name="parse227" signature="parse227(resp)" />
