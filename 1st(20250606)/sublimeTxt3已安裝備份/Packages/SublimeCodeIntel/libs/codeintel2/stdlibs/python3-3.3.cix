        <scope doc="Resets the scheme and fontset of the Tix application&#10;tonewScheme and newFontSet, respectively. This affects only&#10;those widgets created after this call." ilk="function" line="190" lineend="208" name="tix_resetoptions" returns="self.tk.call()" signature="tix_resetoptions(self, newScheme, newFontSet, newScmPrio=None)">
