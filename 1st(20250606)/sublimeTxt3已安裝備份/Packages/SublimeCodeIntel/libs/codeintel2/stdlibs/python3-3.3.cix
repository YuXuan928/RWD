        <scope doc="Write debugging output to sys.stderr." ilk="function" name="_dbg" signature="_dbg(self, level, msg)" />
        <scope doc="Make a character or block device called targetpath." ilk="function" name="makedev" signature="makedev(self, tarinfo, targetpath)" />
        <scope doc="Make a (symbolic) link called targetpath. If it cannot be&#10;created(platform limitation), we try to make a copy of the&#10;referenced file instead of a link." ilk="function" name="makelink" signature="makelink(self, tarinfo, targetpath)" />
        <scope doc="Return the members of the archive as a list of TarInfo&#10;objects. Thelist has the same order as the members in the&#10;archive." ilk="function" name="getmembers" signature="getmembers(self)" />
        <scope doc="Extract all members from the archive to the current&#10;workingdirectory and set owner, modification time and&#10;permissions on directories afterwards. `path' specifies a&#10;different directory to extract to." ilk="function" name="extractall" signature="extractall(self, path='.', members=None)" />
        <scope doc="Open a tar archive for reading, writing or appending.&#10;Returnan appropriate TarFile class." ilk="function" name="open" />
        <scope doc="Set file permissions of targetpath according to tarinfo." ilk="function" name="chmod" signature="chmod(self, tarinfo, targetpath)" />
        <scope doc="Extract a member from the archive as a file object. `member'&#10;may bea filename or a TarInfo object." ilk="function" name="extractfile" signature="extractfile(self, member)" />
        <scope doc="Return the next member of the archive as a TarInfo object,&#10;whenTarFile is opened for reading. Return None if there is&#10;no more available." ilk="function" name="next" signature="next(self)" />
      </scope>
      <scope classrefs="object" doc="Informational class which holds the details about anarchive member given by a tar header block. TarInfo objects are returned by TarFile.getmember(), TarFile.getmembers() and TarFile.gettarinfo() and are usually created internally." ilk="class" name="TarInfo">
        <scope ilk="function" name="isdir" signature="isdir(self)" />
        <scope ilk="function" name="isfifo" signature="isfifo(self)" />
        <scope doc="Return a header block. info is a dictionary with&#10;fileinformation, format must be one of the *_FORMAT&#10;constants." ilk="function" name="_create_header" signature="_create_header(info, format, encoding, errors)" />
        <scope ilk="function" name="issym" signature="issym(self)" />
        <scope doc="Process a GNU sparse header plus extra headers." ilk="function" name="_proc_sparse" signature="_proc_sparse(self, tarfile)" />
        <scope doc="Process a GNU tar extended sparse header, version 1.0." ilk="function" name="_proc_gnusparse_10" signature="_proc_gnusparse_10(self, next, pax_headers, tarfile)" />
        <scope doc="Process a builtin type or an unknown type whichwill be&#10;treated as a regular file." ilk="function" name="_proc_builtin" signature="_proc_builtin(self, tarfile)" />
        <scope ilk="function" name="isreg" signature="isreg(self)" />
        <scope doc="Return the string payload filled with zero bytesup to the&#10;next 512 byte border." ilk="function" name="_create_payload" signature="_create_payload(payload)" />
        <scope doc="Construct a TarInfo object from a 512 byte bytes object." ilk="function" name="frombuf" />
        <scope ilk="function" name="isblk" signature="isblk(self)" />
        <scope doc="Return the object as a GNU header block sequence." ilk="function" name="create_gnu_header" signature="create_gnu_header(self, info, encoding, errors)" />
        <scope ilk="function" name="islnk" signature="islnk(self)" />
        <scope ilk="function" name="_getlinkpath" signature="_getlinkpath(self)" />
        <scope doc="Return the next TarInfo object from TarFile objecttarfile." ilk="function" name="fromtarfile" />
        <scope ilk="function" name="_setpath" signature="_setpath(self, name)" />
        <scope ilk="function" name="__repr__" signature="__repr__(self)" />
        <scope doc="Return a GNUTYPE_LONGNAME or GNUTYPE_LONGLINK sequencefor&#10;name." ilk="function" name="_create_gnu_long_header" />
        <scope doc="Return the TarInfo's attributes as a dictionary." ilk="function" name="get_info" signature="get_info(self)" />
        <scope ilk="function" name="issparse" signature="issparse(self)" />
        <scope doc="Process an extended or global header as described&#10;inPOSIX.1-2008." ilk="function" name="_proc_pax" signature="_proc_pax(self, tarfile)" />
        <scope doc="Replace fields with supplemental information from a&#10;previouspax extended or global header." ilk="function" name="_apply_pax_info" signature="_apply_pax_info(self, pax_headers, encoding, errors)" />
        <scope ilk="function" name="_setlinkpath" signature="_setlinkpath(self, linkname)" />
        <scope doc="Return the object as a ustar header block." ilk="function" name="create_ustar_header" signature="create_ustar_header(self, info, encoding, errors)" />
        <scope ilk="function" name="isfile" signature="isfile(self)" />
        <scope doc="Round up a byte count by BLOCKSIZE and return it,e.g.&#10;_block(834) =&gt; 1024." ilk="function" name="_block" signature="_block(self, count)" />
        <scope doc="Choose the right processing method depending onthe type and&#10;call it." ilk="function" name="_proc_member" signature="_proc_member(self, tarfile)" />
        <scope doc="# In pax headers the &quot;name&quot; and &quot;linkname&quot; field are called#&#10;&quot;path&quot; and &quot;linkpath&quot;." ilk="function" name="_getpath" signature="_getpath(self)" />
        <scope doc="Return a POSIX.1-2008 extended or global header sequencethat&#10;contains a list of keyword, value pairs. The values must be&#10;strings." ilk="function" name="_create_pax_generic_header" />
        <scope doc="Construct a TarInfo object. name is the optional nameof the&#10;member." ilk="function" name="__init__" signature="__init__(self, name='')" />
        <scope doc="Return the object as a ustar header block. If it cannot&#10;berepresented this way, prepend a pax extended header&#10;sequence with supplement information." ilk="function" name="create_pax_header" signature="create_pax_header(self, info, encoding)" />
        <scope ilk="function" name="isdev" signature="isdev(self)" />
        <scope doc="Decode a single field from a pax record." ilk="function" name="_decode_pax_field" signature="_decode_pax_field(self, value, encoding, fallback_encoding, fallback_errors)" />
        <scope doc="Process a GNU tar extended sparse header, version 0.1." ilk="function" name="_proc_gnusparse_01" signature="_proc_gnusparse_01(self, next, pax_headers)" />
        <scope doc="Process a GNU tar extended sparse header, version 0.0." ilk="function" name="_proc_gnusparse_00" signature="_proc_gnusparse_00(self, next, pax_headers, buf)" />
        <scope doc="Return a tar header as a string of 512 byte blocks." ilk="function" name="tobuf" signature="tobuf(self, format=1, encoding='utf-8', errors='surrogateescape')" />
        <scope doc="Process the blocks that hold a GNU longnameor longlink&#10;member." ilk="function" name="_proc_gnulong" signature="_proc_gnulong(self, tarfile)" />
        <scope ilk="function" name="ischr" signature="ischr(self)" />
        <scope doc="Split a name longer than 100 chars into a prefixand a name&#10;part." ilk="function" name="_posix_split_name" signature="_posix_split_name(self, name)" />
        <scope doc="Return the object as a pax global header block sequence." ilk="function" name="create_pax_global_header" />
      </scope>
      <scope classrefs="object" doc="Iterator Class.&#10;for tarinfo in TarFile(...): suite..." ilk="class" name="TarIter">
        <scope doc="Return iterator object." ilk="function" name="__iter__" signature="__iter__(self)" />
