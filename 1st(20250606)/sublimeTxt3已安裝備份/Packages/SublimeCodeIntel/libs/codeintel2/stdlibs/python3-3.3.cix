      <scope classrefs="Widget XView" doc="spinbox widget." ilk="class" name="Spinbox">
        <scope doc="Internal function." ilk="function" name="selection" signature="selection(self, *args)" />
        <scope doc="Internal function." ilk="function" name="scan" signature="scan(self, *args)" />
        <scope doc="Clear the selection If the selection isn't in this widget&#10;then the command has no effect." ilk="function" name="selection_clear" signature="selection_clear(self)" />
        <scope doc="Insert string s at index Returns an empty string." ilk="function" name="insert" signature="insert(self, index, s)" />
        <scope doc="Causes the specified element to be invoked The element could&#10;be buttondown or buttonup triggering the action associated&#10;with it." ilk="function" name="invoke" signature="invoke(self, element)" />
        <scope doc="Compute the difference between the given x argumentand the x&#10;argument to the last scan mark command  It then adjusts the&#10;view left or right by 10 times the difference in&#10;x-coordinates. This command is typically associated with&#10;mouse motion events in the widget, to produce the effect of&#10;dragging the spinbox at high speed through the window." ilk="function" name="scan_dragto" signature="scan_dragto(self, x)" />
        <scope doc="Return a tuple of X1,Y1,X2,Y2 coordinates for arectangle&#10;which encloses the character given by index. The first two&#10;elements of the list give the x and y coordinates of the&#10;upper-left corner of the screen area covered by the&#10;character (in pixels relative to the widget) and the last&#10;two elements give the width and height of the character, in&#10;pixels." ilk="function" name="bbox" signature="bbox(self, index)" />
        <scope doc="Sets or gets the currently selected element." ilk="function" name="selection_element" signature="selection_element(self, element=None)" />
