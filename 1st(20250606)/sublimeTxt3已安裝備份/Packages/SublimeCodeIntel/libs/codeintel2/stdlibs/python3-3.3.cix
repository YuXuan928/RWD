        <scope doc="Read the directory, making sure we close the file if the&#10;formatis bad." ilk="function" name="_GetContents" signature="_GetContents(self)" />
        <scope doc="Return a list of class ZipInfo instances for files in&#10;thearchive." ilk="function" name="infolist" signature="infolist(self)" />
        <scope doc="Write a file into the archive. The contents is 'data',&#10;whichmay be either a 'str' or a 'bytes' instance; if it is a&#10;'str', it is encoded as UTF-8 first." ilk="function" name="writestr" signature="writestr(self, zinfo_or_arcname, data, compress_type=None)" />
        <scope doc="Return a list of file names in the archive." ilk="function" name="namelist" signature="namelist(self)" />
