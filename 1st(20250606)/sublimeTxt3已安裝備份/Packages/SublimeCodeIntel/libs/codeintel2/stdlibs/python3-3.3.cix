        <scope doc="Always returns False since BytesIO objects are not connected&#10;to a tty-like device." ilk="function" name="isatty" signature="isatty() -&gt; False." />
        <scope doc="Seek to byte offset pos relative to position indicated by&#10;whence: 0  Start of stream (the default). pos should be &gt;=&#10;0; 1  Current position - pos may be negative; 2  End of&#10;stream - pos usually negative." ilk="function" name="seek" signature="seek(pos, whence=0) -&gt; int.  Change stream position." />
        <scope doc="Size defaults to the current file position, as returned by&#10;tell(). The current file position is unchanged." ilk="function" name="truncate" signature="truncate([size]) -&gt; int.  Truncate the file to at most size bytes." />
        <scope doc="Call readline() repeatedly and return a list of the lines so&#10;read. The optional size argument, if given, is an&#10;approximate bound on the total number of bytes in the lines&#10;returned." ilk="function" name="readlines" returns="list" signature="readlines([size]) -&gt; list of strings, each a line from the file." />
      </scope>
      <variable citdl="int" name="DEFAULT_BUFFER_SIZE" />
      <scope classrefs="_RawIOBase" doc="file(name: str[, mode: str][, opener: None]) -&gt; file IO object&#10;Open a file.  The mode can be 'r', 'w', 'x' or 'a' for reading (default), writing, exclusive creation or appending.  The file will be created if it doesn't exist when opened for writing or appending; it will be truncated when opened for writing.  A `FileExistsError` will be raised if it already exists when opened for creating. Opening a file for creating implies writing so this mode behaves in a similar way to 'w'.Add a '+' to the mode to allow simultaneous reading and writing. A custom opener can be used by passing a callable as *opener*. The underlying file descriptor for the file object is then obtained by calling opener with (*name*, *flags*). *opener* must return an open file descriptor (passing os.open as *opener*" ilk="class" name="FileIO">
        <scope doc="A closed file cannot be used for further I/O operations.&#10;close() may be called more than once without error." ilk="function" name="close" signature="close() -&gt; None.  Close the file." />
        <scope doc="tell() -&gt; int.  Current file position" ilk="function" name="tell" signature="tell() -&gt; int.  Current file position" />
        <scope doc="readinto() -&gt; Same as RawIOBase.readinto()." ilk="function" name="readinto" signature="readinto() -&gt; Same as RawIOBase.readinto()." />
        <scope doc="Only makes one system call, so less data may be returned&#10;than requested In non-blocking mode, returns None if no data&#10;is available. On end-of-file, returns ''." ilk="function" name="read" signature="read(size: int) -&gt; bytes.  read at most size bytes, returned as bytes." />
        <scope doc="This is needed for lower-level file interfaces, such the&#10;fcntl module." ilk="function" name="fileno" signature="fileno() -&gt; int. &quot;file descriptor&quot;." />
        <scope doc="Size defaults to the current file position, as returned by&#10;tell().The current file position is changed to the value of&#10;size." ilk="function" name="truncate" signature="truncate([size: int]) -&gt; None.  Truncate the file to at most size bytes." />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="seekable() -&gt; bool.  True if file supports random-access." ilk="function" name="seekable" signature="seekable() -&gt; bool.  True if file supports random-access." />
        <scope doc="readable() -&gt; bool.  True if file was opened in a read mode." ilk="function" name="readable" signature="readable() -&gt; bool.  True if file was opened in a read mode." />
        <scope doc="writable() -&gt; bool.  True if file was opened in a write mode." ilk="function" name="writable" signature="writable() -&gt; bool.  True if file was opened in a write mode." />
