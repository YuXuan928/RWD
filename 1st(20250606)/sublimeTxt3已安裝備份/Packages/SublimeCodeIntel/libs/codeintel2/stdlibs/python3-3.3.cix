      <scope doc="Add site-packages (and possibly site-python) to sys.path" ilk="function" name="addsitepackages" signature="addsitepackages(known_paths, prefixes=None)" />
      <scope doc="Add a per user site-package to sys.path Each user has its&#10;own python directory with site-packages in the home&#10;directory." ilk="function" name="addusersitepackages" signature="addusersitepackages(known_paths)" />
      <scope doc="On Windows, some default encodings are not provided by&#10;Python,while they are always available as &quot;mbcs&quot; in each&#10;locale. Make them usable by aliasing to &quot;mbcs&quot; in such a&#10;case." ilk="function" name="aliasmbcs" signature="aliasmbcs()" />
      <import module="builtins" />
