    <scope doc="plistlib.py -- a tool to generate and parse MacOSX .plist files.&#10;The property list (.plist) file format is a simple XML pickle supporting basic object types, like dictionaries, lists, numbers and strings. Usually the top level object is a dictionary.  To write out a plist file, use the writePlist(rootObject, pathOrFile) function. 'rootObject' is the top level object, 'pathOrFile' is a filename or a (writable) file object.  To parse a plist from a file, use the readPlist(pathOrFile) function, with a file name or a (readable) file object as the only argument. It" ilk="blob" lang="Python3" name="Lib.plistlib">
      <scope classrefs="_BufferedIOBase" doc="BytesIO([buffer]) -&gt; object&#10;Create a buffered I/O implementation using an in-memory bytes buffer, ready for reading and writing." ilk="class" name="BytesIO">
        <scope ilk="function" name="__setstate__" />
        <scope doc="tell() -&gt; current file position, an integer" ilk="function" name="tell" signature="tell() -&gt; current file position, an integer" />
        <scope doc="Returns number of bytes read (0 for EOF), or None if the&#10;object is set not to block as has no data to read." ilk="function" name="readinto" signature="readinto(bytearray) -&gt; int.  Read up to len(b) bytes into b." />
        <scope doc="If the size argument is negative, read until EOF is reached.&#10;Return an empty string at EOF." ilk="function" name="read" signature="read([size]) -&gt; read at most size bytes, returned as a string." />
        <scope doc="close() -&gt; None.  Disable all I/O operations." ilk="function" name="close" signature="close() -&gt; None.  Disable all I/O operations." />
        <scope doc="flush() -&gt; None.  Does nothing." ilk="function" name="flush" signature="flush() -&gt; None.  Does nothing." />
        <scope ilk="function" name="readable" />
        <scope doc="x.__iter__() &lt;==&gt; iter(x)" ilk="function" name="__iter__" signature="x.__iter__() &lt;==&gt; iter(x)" />
        <scope ilk="function" name="seekable" />
        <scope doc="Retain newline. A non-negative size argument limits the&#10;maximum number of bytes to return (an incomplete line may be&#10;returned then)." ilk="function" name="readline" signature="readline([size]) -&gt; next line from the file, as a string." />
        <scope doc="x.__next__() &lt;==&gt; next(x)" ilk="function" name="__next__" signature="x.__next__() &lt;==&gt; next(x)" />
        <scope ilk="function" name="writable" />
        <scope ilk="function" name="__init__" />
        <scope doc="Get a read-write view over the contents of the BytesIO&#10;object." ilk="function" name="getbuffer" signature="getbuffer() -&gt; bytes." />
        <scope doc="Retrieve the entire contents of the BytesIO object." ilk="function" name="getvalue" signature="getvalue() -&gt; bytes." />
        <scope doc="Note that newlines are not added. The sequence can be any&#10;iterable object producing strings." ilk="function" name="writelines" signature="writelines(sequence_of_strings) -&gt; None.  Write strings to the file." />
        <scope ilk="function" name="__getstate__" />
        <scope doc="If the size argument is negative or omitted, read until EOF&#10;is reached. Return an empty string at EOF." ilk="function" name="read1" signature="read1(size) -&gt; read at most size bytes, returned as a string." />
        <scope doc="Return the number of bytes written." ilk="function" name="write" signature="write(bytes) -&gt; int.  Write bytes to file." />
        <scope doc="Always returns False since BytesIO objects are not connected&#10;to a tty-like device." ilk="function" name="isatty" signature="isatty() -&gt; False." />
        <scope doc="Seek to byte offset pos relative to position indicated by&#10;whence: 0  Start of stream (the default). pos should be &gt;=&#10;0; 1  Current position - pos may be negative; 2  End of&#10;stream - pos usually negative." ilk="function" name="seek" signature="seek(pos, whence=0) -&gt; int.  Change stream position." />
        <scope doc="Size defaults to the current file position, as returned by&#10;tell(). The current file position is unchanged." ilk="function" name="truncate" signature="truncate([size]) -&gt; int.  Truncate the file to at most size bytes." />
        <scope doc="Call readline() repeatedly and return a list of the lines so&#10;read. The optional size argument, if given, is an&#10;approximate bound on the total number of bytes in the lines&#10;returned." ilk="function" name="readlines" returns="list" signature="readlines([size]) -&gt; list of strings, each a line from the file." />
      </scope>
