        <scope doc="Set the fixed end oft the selection to INDEX." ilk="function" name="select_anchor" signature="select_anchor(self, index)" />
        <scope doc="Get list of items from FIRST to LAST (not included)." ilk="function" name="get" signature="get(self, first, last=None)" />
        <scope doc="Set the selection from FIRST to LAST (not included)&#10;withoutchanging the currently selected elements." ilk="function" name="selection_set" signature="selection_set(self, first, last=None)" />
        <scope doc="Get index of item which is nearest to y coordinate Y." ilk="function" name="nearest" signature="nearest(self, y)" />
        <scope doc="Set the selection from FIRST to LAST (not included)&#10;withoutchanging the currently selected elements." ilk="function" name="select_set" signature="select_set(self, first, last=None)" />
