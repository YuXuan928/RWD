        <scope doc="Return None as built-in modules are never packages." ilk="function" name="is_package" />
        <scope doc="Return None as built-in modules do not have code objects." ilk="function" name="get_code" />
      </scope>
      <scope doc="Alias for bisect_right()." ilk="function" name="bisect" />
      <scope doc="Return the index where to insert item x in list a, assuming&#10;a is sorted. The return value i is such that all e in a[:i]&#10;have e &lt; x, and all e in a[i:] have e &gt;= x." ilk="function" name="bisect_left" signature="bisect_left(a, x[, lo[, hi]]) -&gt; index" />
      <scope doc="Return the index where to insert item x in list a, assuming&#10;a is sorted. The return value i is such that all e in a[:i]&#10;have e &lt;= x, and all e in a[i:] have e &gt; x." ilk="function" name="bisect_right" signature="bisect_right(a, x[, lo[, hi]]) -&gt; index" />
      <scope doc="Alias for insort_right()." ilk="function" name="insort" />
      <scope doc="Insert item x in list a, and keep it sorted assuming a is&#10;sorted. If x is already in a, insert it to the left of the&#10;leftmost x." ilk="function" name="insort_left" signature="insort_left(a, x[, lo[, hi]])" />
      <scope doc="Insert item x in list a, and keep it sorted assuming a is&#10;sorted. If x is already in a, insert it to the right of the&#10;rightmost x." ilk="function" name="insort_right" signature="insort_right(a, x[, lo[, hi]])" />
