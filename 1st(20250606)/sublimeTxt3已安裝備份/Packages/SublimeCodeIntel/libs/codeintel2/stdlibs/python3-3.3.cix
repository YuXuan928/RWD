      <scope classrefs="BaseWidget Pack Place Grid Form Form" doc="Internal class.&#10;Base class for a widget which can be positioned with the geometry managers Pack, Place or Grid." ilk="class" name="Widget" />
      <scope classrefs="object" doc="Provides functions for the communication with the window manager." ilk="class" name="Wm">
        <scope doc="Instruct the window manager that the size of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="sizefrom" signature="sizefrom(self, who=None)" />
        <scope doc="Instruct the window manager that the position of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="positionfrom" signature="positionfrom(self, who=None)" />
        <scope doc="Set the title of this widget." ilk="function" name="title" signature="title(self, string=None)" />
        <scope doc="Instruct the window manager that this widget is&#10;transientwith regard to widget MASTER." ilk="function" name="transient" signature="transient(self, master=None)" />
        <scope doc="Set bitmap for the iconified widget to BITMAP. Returnthe&#10;bitmap if None is given." ilk="function" name="iconbitmap" signature="iconbitmap(self, bitmap=None, default=None)" />
        <scope doc="Query or set the state of this widget as one of normal,&#10;icon,iconic (see wm_iconwindow), withdrawn, or zoomed&#10;(Windows only)." ilk="function" name="state" signature="state(self, newstate=None)" />
        <scope doc="Instruct the window manager that this widget shall only&#10;beresized on grid boundaries. WIDTHINC and HEIGHTINC are the&#10;width and height of a grid unit in pixels." ilk="function" name="wm_grid" signature="wm_grid(self, baseWidth=None, baseHeight=None, widthInc=None, heightInc=None)" />
        <scope doc="Set the name of the icon for this widget. Return the name&#10;ifNone is given." ilk="function" name="wm_iconname" signature="wm_iconname(self, newName=None)" />
        <scope doc="Store NAME in WM_CLIENT_MACHINE property of this widget.&#10;Returncurrent value." ilk="function" name="wm_client" signature="wm_client(self, name=None)" />
        <scope doc="Display widget as icon." ilk="function" name="iconify" signature="iconify(self)" />
        <scope doc="Set focus model to MODEL. &quot;active&quot; means that this widget&#10;will claimthe focus itself, &quot;passive&quot; means that the window&#10;manager shall give the focus." ilk="function" name="wm_focusmodel" signature="wm_focusmodel(self, model=None)" />
        <scope doc="Set the title of this widget." ilk="function" name="wm_title" signature="wm_title(self, string=None)" />
        <scope doc="Instruct the window manager to ignore this widgetif BOOLEAN&#10;is given with 1. Return the current value if None is given." ilk="function" name="overrideredirect" signature="overrideredirect(self, boolean=None)" />
        <scope doc="Store NAME in WM_CLIENT_MACHINE property of this widget.&#10;Returncurrent value." ilk="function" name="client" signature="client(self, name=None)" />
        <scope doc="The widget specified will become a stand alone top-level&#10;window.The window will be decorated with the window managers&#10;title bar, etc." ilk="function" name="manage" signature="manage(self, widget)" />
        <scope doc="Deiconify this widget. If it was never mapped it will not be&#10;mapped.On Windows it will raise this widget and give it the&#10;focus." ilk="function" name="deiconify" signature="deiconify(self)" />
        <scope doc="Store VALUE in WM_COMMAND property. It is the commandwhich&#10;shall be used to invoke the application." ilk="function" name="wm_command" signature="wm_command(self, value=None)" />
        <scope doc="Instruct the window manager that this widget is&#10;transientwith regard to widget MASTER." ilk="function" name="wm_transient" signature="wm_transient(self, master=None)" />
        <scope doc="Sets the titlebar icon for this window based on the named&#10;photoimages passed through args. If default is True, this is&#10;applied to all future created toplevels as well." ilk="function" name="wm_iconphoto" signature="wm_iconphoto(self, default=False, *args)" />
        <scope doc="Set min WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="wm_minsize" signature="wm_minsize(self, width=None, height=None)" />
        <scope doc="Set bitmap for the iconified widget to BITMAP. Returnthe&#10;bitmap if None is given." ilk="function" name="wm_iconbitmap" signature="wm_iconbitmap(self, bitmap=None, default=None)" />
        <scope doc="Set mask for the icon bitmap of this widget. Return themask&#10;if None is given." ilk="function" name="wm_iconmask" signature="wm_iconmask(self, bitmap=None)" />
        <scope doc="The window will be unmappend from the screen and will no&#10;longerbe managed by wm. toplevel windows will be treated&#10;like frame windows once they are no longer managed by wm,&#10;however, the menu option configuration will be remembered&#10;and the menus will return once the widget is managed again." ilk="function" name="wm_forget" signature="wm_forget(self, window)" />
        <scope doc="Instruct the window manager whether this width can be&#10;resizedin WIDTH or HEIGHT. Both values are boolean values." ilk="function" name="wm_resizable" signature="wm_resizable(self, width=None, height=None)" />
        <scope doc="Store list of window names (WLIST) into WM_COLORMAPWINDOWS&#10;propertyof this widget. This list contains windows whose&#10;colormaps differ from their parents." ilk="function" name="colormapwindows" signature="colormapwindows(self, *wlist)" />
        <scope doc="Deiconify this widget. If it was never mapped it will not be&#10;mapped.On Windows it will raise this widget and give it the&#10;focus." ilk="function" name="wm_deiconify" signature="wm_deiconify(self)" />
        <scope doc="Store VALUE in WM_COMMAND property. It is the commandwhich&#10;shall be used to invoke the application." ilk="function" name="command" signature="command(self, value=None)" />
        <scope doc="Return identifier for decorative frame of this widget if&#10;present." ilk="function" name="wm_frame" signature="wm_frame(self)" />
        <scope doc="Instruct the window manager that this widget shall only&#10;beresized on grid boundaries. WIDTHINC and HEIGHTINC are the&#10;width and height of a grid unit in pixels." ilk="function" name="grid" signature="grid(self, baseWidth=None, baseHeight=None, widthInc=None, heightInc=None)" />
        <scope doc="Display widget as icon." ilk="function" name="wm_iconify" signature="wm_iconify(self)" />
        <scope doc="Store list of window names (WLIST) into WM_COLORMAPWINDOWS&#10;propertyof this widget. This list contains windows whose&#10;colormaps differ from their parents." ilk="function" name="wm_colormapwindows" signature="wm_colormapwindows(self, *wlist)" />
        <scope doc="Instruct the window manager that the size of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="wm_sizefrom" signature="wm_sizefrom(self, who=None)" />
        <scope doc="Set geometry to NEWGEOMETRY of the form =widthxheight+x+y.&#10;Returncurrent value if None is given." ilk="function" name="geometry" signature="geometry(self, newGeometry=None)" />
        <scope doc="Withdraw this widget from the screen such that it is&#10;unmappedand forgotten by the window manager. Re-draw it with&#10;wm_deiconify." ilk="function" name="wm_withdraw" signature="wm_withdraw(self)" />
        <scope doc="This subcommand returns or sets platform specific attributes&#10;The first form returns a list of the platform specific flags&#10;and their values." ilk="function" name="attributes" signature="attributes(self, *args)" />
        <scope doc="Set widget PATHNAME to be displayed instead of icon. Return&#10;the currentvalue if None is given." ilk="function" name="iconwindow" signature="iconwindow(self, pathName=None)" />
        <scope doc="Set the group leader widgets for related widgets to&#10;PATHNAME. Returnthe group leader of this widget if None is&#10;given." ilk="function" name="wm_group" signature="wm_group(self, pathName=None)" />
        <scope doc="Bind function FUNC to command NAME for this widget.Return&#10;the function bound to NAME if None is given. NAME could be&#10;e.g." ilk="function" name="wm_protocol" signature="wm_protocol(self, name=None, func=None)" />
        <scope doc="This subcommand returns or sets platform specific attributes&#10;The first form returns a list of the platform specific flags&#10;and their values." ilk="function" name="wm_attributes" signature="wm_attributes(self, *args)" />
        <scope doc="Set max WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="wm_maxsize" signature="wm_maxsize(self, width=None, height=None)" />
        <scope doc="Set widget PATHNAME to be displayed instead of icon. Return&#10;the currentvalue if None is given." ilk="function" name="wm_iconwindow" signature="wm_iconwindow(self, pathName=None)" />
        <scope doc="Instruct the window manager whether this width can be&#10;resizedin WIDTH or HEIGHT. Both values are boolean values." ilk="function" name="resizable" signature="resizable(self, width=None, height=None)" />
        <scope doc="Instruct the window manager to set the aspect ratio&#10;(width/height)of this widget to be between MINNUMER/MINDENOM&#10;and MAXNUMER/MAXDENOM. Return a tuple of the actual values&#10;if no argument is given." ilk="function" name="wm_aspect" signature="wm_aspect(self, minNumer=None, minDenom=None, maxNumer=None, maxDenom=None)" />
        <scope doc="Set the name of the icon for this widget. Return the name&#10;ifNone is given." ilk="function" name="iconname" signature="iconname(self, newName=None)" />
        <scope doc="Set the group leader widgets for related widgets to&#10;PATHNAME. Returnthe group leader of this widget if None is&#10;given." ilk="function" name="group" signature="group(self, pathName=None)" />
        <scope doc="Query or set the state of this widget as one of normal,&#10;icon,iconic (see wm_iconwindow), withdrawn, or zoomed&#10;(Windows only)." ilk="function" name="wm_state" signature="wm_state(self, newstate=None)" />
        <scope doc="Withdraw this widget from the screen such that it is&#10;unmappedand forgotten by the window manager. Re-draw it with&#10;wm_deiconify." ilk="function" name="withdraw" signature="withdraw(self)" />
        <scope doc="Return identifier for decorative frame of this widget if&#10;present." ilk="function" name="frame" signature="frame(self)" />
        <scope doc="Set geometry to NEWGEOMETRY of the form =widthxheight+x+y.&#10;Returncurrent value if None is given." ilk="function" name="wm_geometry" signature="wm_geometry(self, newGeometry=None)" />
        <scope doc="Sets the titlebar icon for this window based on the named&#10;photoimages passed through args. If default is True, this is&#10;applied to all future created toplevels as well." ilk="function" name="iconphoto" signature="iconphoto(self, default=False, *args)" />
        <scope doc="The widget specified will become a stand alone top-level&#10;window.The window will be decorated with the window managers&#10;title bar, etc." ilk="function" name="wm_manage" signature="wm_manage(self, widget)" />
        <scope doc="Set min WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="minsize" signature="minsize(self, width=None, height=None)" />
        <scope doc="Set the position of the icon of this widget to X and Y.&#10;Returna tuple of the current values of X and X if None is&#10;given." ilk="function" name="wm_iconposition" signature="wm_iconposition(self, x=None, y=None)" />
        <scope doc="Instruct the window manager that the position of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="wm_positionfrom" signature="wm_positionfrom(self, who=None)" />
        <scope doc="Set max WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="maxsize" signature="maxsize(self, width=None, height=None)" />
        <scope doc="Set mask for the icon bitmap of this widget. Return themask&#10;if None is given." ilk="function" name="iconmask" signature="iconmask(self, bitmap=None)" />
        <scope doc="Set the position of the icon of this widget to X and Y.&#10;Returna tuple of the current values of X and X if None is&#10;given." ilk="function" name="iconposition" signature="iconposition(self, x=None, y=None)" />
        <scope doc="The window will be unmappend from the screen and will no&#10;longerbe managed by wm. toplevel windows will be treated&#10;like frame windows once they are no longer managed by wm,&#10;however, the menu option configuration will be remembered&#10;and the menus will return once the widget is managed again." ilk="function" name="forget" signature="forget(self, window)" />
        <scope doc="Set focus model to MODEL. &quot;active&quot; means that this widget&#10;will claimthe focus itself, &quot;passive&quot; means that the window&#10;manager shall give the focus." ilk="function" name="focusmodel" signature="focusmodel(self, model=None)" />
        <scope doc="Instruct the window manager to ignore this widgetif BOOLEAN&#10;is given with 1. Return the current value if None is given." ilk="function" name="wm_overrideredirect" signature="wm_overrideredirect(self, boolean=None)" />
        <scope doc="Instruct the window manager to set the aspect ratio&#10;(width/height)of this widget to be between MINNUMER/MINDENOM&#10;and MAXNUMER/MAXDENOM. Return a tuple of the actual values&#10;if no argument is given." ilk="function" name="aspect" signature="aspect(self, minNumer=None, minDenom=None, maxNumer=None, maxDenom=None)" />
        <scope doc="Bind function FUNC to command NAME for this widget.Return&#10;the function bound to NAME if None is given. NAME could be&#10;e.g." ilk="function" name="protocol" signature="protocol(self, name=None, func=None)" />
