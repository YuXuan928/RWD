      <scope doc="Kill a process group with a signal." ilk="function" name="killpg" signature="killpg(pgid, sig)" />
      <scope doc="Change the owner and group id of path to the numeric uid and&#10;gid." ilk="function" name="lchown" signature="lchown(path, uid, gid)" />
      <scope doc="Create a hard link to a file." ilk="function" name="link" signature="link(src, dst, *, src_dir_fd=None, dst_dir_fd=None, follow_symlinks=True)" />
      <scope doc="Return a list containing the names of the files in the&#10;directory." ilk="function" name="listdir" signature="listdir(path='.') -&gt; list_of_filenames" />
      <scope doc="Return a list of extended attributes on path." ilk="function" name="listxattr" signature="listxattr(path='.', *, follow_symlinks=True)" />
