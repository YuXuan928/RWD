      <scope classrefs="object" doc="str(string[, encoding[, errors]]) -&gt; str&#10;Create a new string object from the given encoded string. encoding defaults to the current default string encoding. errors can be 'strict', 'replace' or 'ignore' and defaults to 'strict'." ilk="class" name="OptimizedUnicode">
        <scope doc="Return True if all cased characters in S are lowercase and&#10;there is at least one cased character in S, False otherwise." ilk="function" name="islower" returns="bool" signature="S.islower() -&gt; bool" />
        <scope doc="x.__le__(y) &lt;==&gt; x&lt;=y" ilk="function" name="__le__" signature="x.__le__(y) &lt;==&gt; x&lt;=y" />
        <scope doc="x.__ne__(y) &lt;==&gt; x!=y" ilk="function" name="__ne__" signature="x.__ne__(y) &lt;==&gt; x!=y" />
        <scope doc="Return a titlecased version of S, i.e. words start with&#10;title case characters, all remaining cased characters have&#10;lower case." ilk="function" name="title" returns="str" signature="S.title() -&gt; str" />
        <scope doc="Return True if all cased characters in S are uppercase and&#10;there is at least one cased character in S, False otherwise." ilk="function" name="isupper" returns="bool" signature="S.isupper() -&gt; bool" />
        <scope doc="Return True if all characters in S are digits and there is&#10;at least one character in S, False otherwise." ilk="function" name="isdigit" returns="bool" signature="S.isdigit() -&gt; bool" />
        <scope doc="x.__eq__(y) &lt;==&gt; x==y" ilk="function" name="__eq__" signature="x.__eq__(y) &lt;==&gt; x==y" />
        <scope doc="Return a formatted version of S, using substitutions from&#10;args and kwargs. The substitutions are identified by braces&#10;('{' and '}')." ilk="function" name="format" returns="str" signature="S.format(*args, **kwargs) -&gt; str" />
        <scope doc="Return a copy of the string S converted to lowercase." ilk="function" name="lower" returns="str" signature="S.lower() -&gt; str" />
        <scope doc="Return a copy of the string S with trailing whitespace&#10;removed. If chars is given and not None, remove characters&#10;in chars instead." ilk="function" name="rstrip" returns="str" signature="S.rstrip([chars]) -&gt; str" />
        <scope doc="x.__iter__() &lt;==&gt; iter(x)" ilk="function" name="__iter__" signature="x.__iter__() &lt;==&gt; iter(x)" />
        <scope doc="Return the number of non-overlapping occurrences of&#10;substring sub in string S[start:end]. Optional arguments&#10;start and end are interpreted as in slice notation." ilk="function" name="count" returns="int" signature="S.count(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__gt__(y) &lt;==&gt; x&gt;y" ilk="function" name="__gt__" signature="x.__gt__(y) &lt;==&gt; x&gt;y" />
        <scope doc="Return the lowest index in S where substring sub is found,&#10;such that sub is contained within S[start:end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="find" returns="int" signature="S.find(sub[, start[, end]]) -&gt; int" />
        <scope doc="Return a list of the lines in S, breaking at line&#10;boundaries. Line breaks are not included in the resulting&#10;list unless keepends is given and true." ilk="function" name="splitlines" returns="list" signature="S.splitlines([keepends]) -&gt; list of strings" />
        <scope doc="Like S.find() but raise ValueError when the substring is not&#10;found." ilk="function" name="index" returns="int" signature="S.index(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__lt__(y) &lt;==&gt; x&lt;y" ilk="function" name="__lt__" signature="x.__lt__(y) &lt;==&gt; x&lt;y" />
        <scope doc="Return a copy of the string S with leading whitespace&#10;removed. If chars is given and not None, remove characters&#10;in chars instead." ilk="function" name="lstrip" returns="str" signature="S.lstrip([chars]) -&gt; str" />
        <scope doc="Return a copy of S where all tab characters are expanded&#10;using spaces. If tabsize is not given, a tab size of 8&#10;characters is assumed." ilk="function" name="expandtabs" returns="str" signature="S.expandtabs([tabsize]) -&gt; str" />
        <scope doc="x.__hash__() &lt;==&gt; hash(x)" ilk="function" name="__hash__" signature="x.__hash__() &lt;==&gt; hash(x)" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="Return True if all characters in S are considered printable&#10;in repr() or S is empty, False otherwise." ilk="function" name="isprintable" returns="bool" signature="S.isprintable() -&gt; bool" />
        <scope doc="Return True if all characters in S are alphabetic and there&#10;is at least one character in S, False otherwise." ilk="function" name="isalpha" returns="bool" signature="S.isalpha() -&gt; bool" />
        <scope doc="Encode S using the codec registered for encoding. Default&#10;encoding is 'utf-8'." ilk="function" name="encode" signature="S.encode(encoding='utf-8', errors='strict') -&gt; bytes" />
        <scope doc="Pad a numeric string S with zeros on the left, to fill a&#10;field of the specified width. The string S is never&#10;truncated." ilk="function" name="zfill" returns="str" signature="S.zfill(width) -&gt; str" />
        <scope doc="Return a list of the words in S, using sep as the delimiter&#10;string. If maxsplit is given, at most maxsplit splits are&#10;done." ilk="function" name="split" returns="list" signature="S.split(sep=None, maxsplit=-1) -&gt; list of strings" />
        <scope doc="x.__mul__(n) &lt;==&gt; x*n" ilk="function" name="__mul__" signature="x.__mul__(n) &lt;==&gt; x*n" />
        <scope doc="Search for the separator sep in S, starting at the end of S,&#10;and return the part before it, the separator itself, and the&#10;part after it. If the separator is not found, return two&#10;empty strings and S." ilk="function" name="rpartition" signature="S.rpartition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Return True if there are only numeric characters in S, False&#10;otherwise." ilk="function" name="isnumeric" returns="bool" signature="S.isnumeric() -&gt; bool" />
        <scope doc="Return True if S is a titlecased string and there is at&#10;least one character in S, i.e. upper- and titlecase&#10;characters may only follow uncased characters and lowercase&#10;characters only cased ones." ilk="function" name="istitle" returns="bool" signature="S.istitle() -&gt; bool" />
        <scope doc="Return a formatted version of S as described by format_spec." ilk="function" name="__format__" returns="str" signature="S.__format__(format_spec) -&gt; str" />
        <scope doc="S.__sizeof__() -&gt; size of S in memory, in bytes" ilk="function" name="__sizeof__" signature="S.__sizeof__() -&gt; size of S in memory, in bytes" />
        <scope doc="Return True if all characters in S are alphanumeric and&#10;there is at least one character in S, False otherwise." ilk="function" name="isalnum" returns="bool" signature="S.isalnum() -&gt; bool" />
        <scope doc="Return a copy of S with all occurrences of substring old&#10;replaced by new. If the optional argument count is given,&#10;only the first count occurrences are replaced." ilk="function" name="replace" returns="str" signature="S.replace(old, new[, count]) -&gt; str" />
        <scope doc="Return a capitalized version of S, i.e. make the first&#10;character have upper case and the rest lower case." ilk="function" name="capitalize" returns="str" signature="S.capitalize() -&gt; str" />
        <scope ilk="function" name="__getnewargs__" />
        <scope doc="Return True if S is a valid identifier according to the&#10;language definition." ilk="function" name="isidentifier" returns="bool" signature="S.isidentifier() -&gt; bool" />
        <scope doc="x.__rmul__(n) &lt;==&gt; n*x" ilk="function" name="__rmul__" signature="x.__rmul__(n) &lt;==&gt; n*x" />
        <scope doc="Return a copy of S converted to uppercase." ilk="function" name="upper" returns="str" signature="S.upper() -&gt; str" />
        <scope doc="Return a string which is the concatenation of the strings in&#10;the iterable. The separator between elements is S." ilk="function" name="join" returns="str" signature="S.join(iterable) -&gt; str" />
        <scope doc="Return S centered in a string of length width." ilk="function" name="center" returns="str" signature="S.center(width[, fillchar]) -&gt; str" />
        <scope doc="x.__rmod__(y) &lt;==&gt; y%x" ilk="function" name="__rmod__" signature="x.__rmod__(y) &lt;==&gt; y%x" />
        <scope doc="Return the highest index in S where substring sub is found,&#10;such that sub is contained within S[start:end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="rfind" returns="int" signature="S.rfind(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Return a list of the words in S, using sep as the delimiter&#10;string, starting at the end of the string and working to the&#10;front. If maxsplit is given, at most maxsplit splits are&#10;done." ilk="function" name="rsplit" returns="list" signature="S.rsplit(sep=None, maxsplit=-1) -&gt; list of strings" />
        <scope doc="Search for the separator sep in S, and return the part&#10;before it, the separator itself, and the part after it. If&#10;the separator is not found, return S and two empty strings." ilk="function" name="partition" signature="S.partition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Return S right-justified in a string of length width.&#10;Padding is done using the specified fill character (default&#10;is a space)." ilk="function" name="rjust" returns="str" signature="S.rjust(width[, fillchar]) -&gt; str" />
        <scope doc="x.__contains__(y) &lt;==&gt; y in x" ilk="function" name="__contains__" signature="x.__contains__(y) &lt;==&gt; y in x" />
        <scope doc="Return True if S ends with the specified suffix, False&#10;otherwise. With optional start, test S beginning at that&#10;position." ilk="function" name="endswith" returns="bool" signature="S.endswith(suffix[, start[, end]]) -&gt; bool" />
        <scope doc="Return a copy of the string S, where all characters have&#10;been mapped through the given translation table, which must&#10;be a mapping of Unicode ordinals to Unicode ordinals,&#10;strings, or None. Unmapped characters are left untouched." ilk="function" name="translate" returns="str" signature="S.translate(table) -&gt; str" />
        <scope doc="Return a version of S suitable for caseless comparisons." ilk="function" name="casefold" returns="str" signature="S.casefold() -&gt; str" />
        <scope doc="x.__ge__(y) &lt;==&gt; x&gt;=y" ilk="function" name="__ge__" signature="x.__ge__(y) &lt;==&gt; x&gt;=y" />
        <scope doc="Return True if there are only decimal characters in S, False&#10;otherwise." ilk="function" name="isdecimal" returns="bool" signature="S.isdecimal() -&gt; bool" />
        <scope doc="Return S left-justified in a Unicode string of length width.&#10;Padding is done using the specified fill character (default&#10;is a space)." ilk="function" name="ljust" returns="str" signature="S.ljust(width[, fillchar]) -&gt; str" />
        <scope doc="x.__getitem__(y) &lt;==&gt; x[y]" ilk="function" name="__getitem__" signature="x.__getitem__(y) &lt;==&gt; x[y]" />
        <scope doc="x.__mod__(y) &lt;==&gt; x%y" ilk="function" name="__mod__" signature="x.__mod__(y) &lt;==&gt; x%y" />
        <scope doc="Like S.rfind() but raise ValueError when the substring is&#10;not found." ilk="function" name="rindex" returns="int" signature="S.rindex(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__add__(y) &lt;==&gt; x+y" ilk="function" name="__add__" signature="x.__add__(y) &lt;==&gt; x+y" />
        <scope doc="Return a formatted version of S, using substitutions from&#10;mapping. The substitutions are identified by braces ('{' and&#10;'}')." ilk="function" name="format_map" returns="str" signature="S.format_map(mapping) -&gt; str" />
        <scope doc="Return True if all characters in S are whitespace and there&#10;is at least one character in S, False otherwise." ilk="function" name="isspace" returns="bool" signature="S.isspace() -&gt; bool" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="x.__len__() &lt;==&gt; len(x)" ilk="function" name="__len__" signature="x.__len__() &lt;==&gt; len(x)" />
        <scope doc="Return True if S starts with the specified prefix, False&#10;otherwise. With optional start, test S beginning at that&#10;position." ilk="function" name="startswith" returns="bool" signature="S.startswith(prefix[, start[, end]]) -&gt; bool" />
        <scope doc="Return a copy of the string S with leading and trailing&#10;whitespace removed. If chars is given and not None, remove&#10;characters in chars instead." ilk="function" name="strip" returns="str" signature="S.strip([chars]) -&gt; str" />
        <scope doc="Return a copy of S with uppercase characters converted to&#10;lowercase and vice versa." ilk="function" name="swapcase" returns="str" signature="S.swapcase() -&gt; str" />
      </scope>
