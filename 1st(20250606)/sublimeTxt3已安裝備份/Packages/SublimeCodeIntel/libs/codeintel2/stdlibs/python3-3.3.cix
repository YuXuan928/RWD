        </scope>
        <scope doc="Compare two IP objects.&#10;&#10;This is only concerned about the comparison of the integer&#10;representation of the network addresses.  This means that the&#10;host bits aren't considered at all in this method.  If you want&#10;to compare host bits, you can easily enough do a&#10;'HostA._ip &lt; HostB._ip'&#10;&#10;Args:&#10;    other: An IP object.&#10;&#10;Returns:&#10;    If the IP versions of self and other are the same, returns:&#10;&#10;    -1 if self &lt; other:&#10;      eg: IPv4Network('192.0.2.0/25') &lt; IPv4Network('192.0.2.128/25')&#10;      IPv6Network('2001:db8::1000/124') &lt;&#10;          IPv6Network('2001:db8::2000/124')&#10;    0 if self == other&#10;      eg: IPv4Network('192.0.2.0/24') == IPv4Network('192.0.2.0/24')&#10;      IPv6Network('2001:db8::1000/124') ==&#10;          IPv6Network('2001:db8::1000/124')&#10;    1 if self &gt; other&#10;      eg: IPv4Network('192.0.2.128/25') &gt; IPv4Network('192.0.2.0/25')&#10;          IPv6Network('2001:db8::2000/124') &gt;&#10;              IPv6Network('2001:db8::1000/124')&#10;&#10;  Raises:&#10;      TypeError if the IP versions are different.&#10;" ilk="function" line="820" lineend="866" name="compare_networks" returns="int" signature="compare_networks(other)">
          <variable citdl="_BaseNetwork" ilk="argument" name="self" />
          <variable ilk="argument" name="other" />
        </scope>
        <scope attributes="protected" doc="Network-only key function.&#10;&#10;Returns an object that identifies this address' network and&#10;netmask. This function is a suitable &quot;key&quot; argument for sorted()&#10;and list.sort().&#10;" ilk="function" line="868" lineend="876" name="_get_networks_key" returns="tuple" signature="_get_networks_key()">
