        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="Only makes one system call, so not all of the data may be&#10;written. The number of bytes actually written is returned." ilk="function" name="write" signature="write(b: bytes) -&gt; int.  Write bytes b to file, return number written." />
        <scope doc="Argument offset is a byte count. Optional argument whence&#10;defaults to 0 (offset from start of file, offset should be&#10;&gt;= 0); other values are 1 (move relative to current&#10;position, positive or negative), and 2 (move relative to end&#10;of file, usually negative, although many platforms allow&#10;seeking beyond the end of a file)." ilk="function" name="seek" signature="seek(offset: int[, whence: int]) -&gt; None.  Move to new file position." />
        <scope doc="In non-blocking mode, returns as much as is immediately&#10;available, or None if no data is available. On end-of-file,&#10;returns ''." ilk="function" name="readall" signature="readall() -&gt; bytes.  read all data from the file, returned as bytes." />
        <scope doc="isatty() -&gt; bool.  True if the file is connected to a tty device." ilk="function" name="isatty" signature="isatty() -&gt; bool.  True if the file is connected to a tty device." />
      </scope>
      <scope classrefs="object" doc="The abstract base class for all I/O classes, acting on streams ofbytes. There is no public constructor.  This class provides dummy implementations for many methods that derived classes can override selectively; the default implementations represent a file that cannot be read, written or seeked.  Even though IOBase does not declare read, readinto, or write because their signatures will vary, implementations and clients should consider those methods part of the interface. Also, implementations may raise UnsupportedOperation when operations they do not support are" ilk="class" name="IOBase">
        <scope doc="Flush and close the IO object." ilk="function" name="close" signature="close(self)" />
        <scope doc="Change stream position." ilk="function" name="seek" signature="seek(self, pos, whence=0)" />
        <scope doc="Return an int indicating the current stream position." ilk="function" name="tell" signature="tell(self)" />
        <scope doc="Internal: raise UnsupportedOperation if file is not writable" ilk="function" name="_checkWritable" signature="_checkWritable(self, msg=None)" />
        <scope doc="Returns underlying file descriptor (an int) if one exists." ilk="function" name="fileno" signature="fileno(self)" />
        <scope doc="Flush write buffers, if applicable." ilk="function" name="flush" signature="flush(self)" />
        <scope doc="Internal: raise an IOError exception for unsupported&#10;operations." ilk="function" name="_unsupported" signature="_unsupported(self, name)" />
        <scope doc="Internal: raise UnsupportedOperation if file is not seekable" ilk="function" name="_checkSeekable" signature="_checkSeekable(self, msg=None)" />
        <scope doc="Return a bool indicating whether object supports random&#10;access." ilk="function" name="seekable" signature="seekable(self)" />
        <scope doc="Return a bool indicating whether object was opened for&#10;reading." ilk="function" name="readable" signature="readable(self)" />
        <scope doc="Context management protocol." ilk="function" name="__exit__" signature="__exit__(self, *args)" />
        <scope doc="Internal: raise an ValueError if file is closed" ilk="function" name="_checkClosed" signature="_checkClosed(self, msg=None)" />
