        <scope doc="Return height of this widget." ilk="function" name="winfo_height" signature="winfo_height(self)" />
        <scope doc="Set or get the status for propagation of geometry&#10;information." ilk="function" name="pack_propagate" signature="pack_propagate(self, flag=['_noarg_'])" />
        <scope doc="Return the y coordinate of the upper left corner of this&#10;widgetin the parent." ilk="function" name="winfo_y" signature="winfo_y(self)" />
        <scope doc="Return the x coordinate of the upper left corner of this&#10;widgetin the parent." ilk="function" name="winfo_x" signature="winfo_x(self)" />
        <scope doc="Return the number of pixels of the width of the screen&#10;ofthis widget in mm." ilk="function" name="winfo_screenmmwidth" signature="winfo_screenmmwidth(self)" />
        <scope doc="Return the Tkinter instance of a widget identified byits Tcl&#10;name NAME." ilk="function" name="_nametowidget" signature="_nametowidget(self, name)" />
        <scope doc="Return the resource value for a KEY given as string." ilk="function" name="__getitem__" signature="__getitem__(self, key)" />
        <scope doc="Return y coordinate of upper left corner of this widget on&#10;theroot window." ilk="function" name="winfo_rooty" signature="winfo_rooty(self)" />
        <scope doc="Return x coordinate of upper left corner of this widget on&#10;theroot window." ilk="function" name="winfo_rootx" signature="winfo_rootx(self)" />
        <scope doc="Internal function." ilk="function" name="_substitute" signature="_substitute(self, *args)" />
        <scope doc="Return the pathname of the widget given by ID." ilk="function" name="winfo_pathname" signature="winfo_pathname(self, id, displayof=0)" />
        <scope doc="Lower this widget in the stacking order." ilk="function" name="lower" signature="lower(self, belowThis=None)" />
        <scope doc="Release grab for this widget if currently set." ilk="function" name="grab_release" signature="grab_release(self)" />
        <scope doc="Return true if at the last color request the colormap was&#10;full." ilk="function" name="winfo_colormapfull" signature="winfo_colormapfull(self)" />
        <scope doc="Rounded integer value of winfo_fpixels." ilk="function" name="winfo_pixels" signature="winfo_pixels(self, number)" />
        <scope doc="Return the value for an option NAME for this widgetwith&#10;CLASSNAME. Values with higher priority override lower&#10;values." ilk="function" name="option_get" signature="option_get(self, name, className)" />
        <scope doc="Send Tcl command CMD to different interpreter INTERP to be&#10;executed." ilk="function" name="send" signature="send(self, interp, cmd, *args)" />
        <scope doc="Return true if the widget and all its higher ancestors are&#10;mapped." ilk="function" name="winfo_viewable" signature="winfo_viewable(self)" />
        <scope doc="Return the widget which is at the root coordinates ROOTX,&#10;ROOTY." ilk="function" name="winfo_containing" signature="winfo_containing(self, rootX, rootY, displayof=0)" />
        <scope doc="Return value of Tcl variable NAME." ilk="function" name="getvar" signature="getvar(self, name='PY_VAR')" />
        <scope doc="Return number of cells in the colormap for this widget." ilk="function" name="winfo_cells" signature="winfo_cells(self)" />
        <scope doc="Return one of the strings directcolor, grayscale,&#10;pseudocolor,staticcolor, staticgray, or truecolor for the&#10;colormodel of this widget." ilk="function" name="winfo_visual" signature="winfo_visual(self)" />
        <scope doc="Return the name of the parent of this widget." ilk="function" name="winfo_parent" signature="winfo_parent(self)" />
        <scope doc="Unbind a virtual event VIRTUAL from SEQUENCE." ilk="function" name="event_delete" signature="event_delete(self, virtual, *sequences)" />
        <scope doc="Return a list of all slaves of this widgetin its packing&#10;order." ilk="function" name="pack_slaves" signature="pack_slaves(self)" />
        <scope doc="Return the x offset of the virtual root relative to the&#10;rootwindow of the screen of this widget." ilk="function" name="winfo_vrootx" signature="winfo_vrootx(self)" />
        <scope doc="Return the y offset of the virtual root relative to the&#10;rootwindow of the screen of this widget." ilk="function" name="winfo_vrooty" signature="winfo_vrooty(self)" />
        <scope doc="Return a tuple of integer coordinates for the boundingbox of&#10;this widget controlled by the geometry manager grid. If&#10;COLUMN, ROW is given the bounding box applies from the cell&#10;with row and column 0 to the specified cell." ilk="function" name="grid_bbox" signature="grid_bbox(self, column=None, row=None, col2=None, row2=None)" />
        <scope doc="Return the number of pixels of the width of the screen&#10;ofthis widget in pixel." ilk="function" name="winfo_screenwidth" signature="winfo_screenwidth(self)" />
        <scope doc="Configure column INDEX of a grid." ilk="function" name="columnconfigure" signature="columnconfigure(self, index, cnf={}, **kw)" />
        <scope doc="Return the screen name of this widget." ilk="function" name="winfo_screen" signature="winfo_screen(self)" />
        <scope doc="Return a list of all slaves of this widgetin its packing&#10;order." ilk="function" name="place_slaves" signature="place_slaves(self)" />
        <scope doc="Return previous widget in the focus order. See tk_focusNext&#10;for details." ilk="function" name="tk_focusPrev" signature="tk_focusPrev(self)" />
        <scope doc="Cancel scheduling of function identified with ID." ilk="function" name="after_cancel" signature="after_cancel(self, id)" />
        <scope doc="The widget under mouse will get automatically focus. Can&#10;notbe disabled easily." ilk="function" name="tk_focusFollowsMouse" signature="tk_focusFollowsMouse(self)" />
        <scope doc="Return the widget which has currently the focus in&#10;theapplication. Use focus_displayof to allow working with&#10;several displays." ilk="function" name="focus_get" signature="focus_get(self)" />
        <scope doc="Raise this widget in the stacking order." ilk="function" name="lift" signature="lift(self, aboveThis=None)" />
        <scope doc="Internal function." ilk="function" name="_displayof" signature="_displayof(self, displayof)" />
        <scope doc="Return one of the strings directcolor, grayscale,&#10;pseudocolor,staticcolor, staticgray, or truecolor for the&#10;default colormodel of this screen." ilk="function" name="winfo_screenvisual" signature="winfo_screenvisual(self)" />
        <scope doc="Internal function." ilk="function" name="_getints" signature="_getints(self, string)" />
        <scope doc="Configure resources of a widget." ilk="function" name="config" signature="config(self, cnf=None, **kw)" />
        <scope doc="Internal function." ilk="function" name="_getdoubles" signature="_getdoubles(self, string)" />
        <scope doc="Internal function." ilk="function" name="_root" signature="_root(self)" />
        <scope doc="Internal function." ilk="function" name="_Misc__winfo_parseitem" signature="_Misc__winfo_parseitem(self, t)" />
        <scope doc="Return a tuple of x and y coordinates of the pointer on the&#10;root window." ilk="function" name="winfo_pointerxy" signature="winfo_pointerxy(self)" />
        <scope ilk="function" name="__setitem__" signature="__setitem__(self, key, value)" />
        <scope doc="Internal function." ilk="function" name="_configure" signature="_configure(self, cmd, cnf, kw)" />
        <scope doc="Return the width of this widget." ilk="function" name="winfo_width" signature="winfo_width(self)" />
        <scope doc="Return the resource value for a KEY given as string." ilk="function" name="cget" signature="cget(self, key)" />
      </scope>
