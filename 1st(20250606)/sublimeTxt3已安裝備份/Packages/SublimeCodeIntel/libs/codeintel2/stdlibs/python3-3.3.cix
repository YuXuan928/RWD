        <scope doc="Return a copy of B where all tab characters are expanded&#10;using spaces. If tabsize is not given, a tab size of 8&#10;characters is assumed." ilk="function" name="expandtabs" signature="B.expandtabs([tabsize]) -&gt; copy of B" />
        <scope doc="Like B.rfind() but raise ValueError when the substring is&#10;not found." ilk="function" name="rindex" returns="int" signature="B.rindex(sub[, start[, end]]) -&gt; int" />
        <scope doc="Return True if all characters in B are alphabetic and there&#10;is at least one character in B, False otherwise." ilk="function" name="isalpha" returns="bool" signature="B.isalpha() -&gt; bool" />
        <scope doc="Return True if all cased characters in B are lowercase and&#10;there is at least one cased character in B, False otherwise." ilk="function" name="islower" returns="bool" signature="B.islower() -&gt; bool" />
        <scope doc="Pad a numeric string B with zeros on the left, to fill a&#10;field of the specified width. B is never truncated." ilk="function" name="zfill" signature="B.zfill(width) -&gt; copy of B" />
        <scope doc="Return a list of the sections in B, using sep as the&#10;delimiter. If sep is not specified or is None, B is split on&#10;ASCII whitespace characters (space, tab, return, newline,&#10;formfeed, vertical tab)." ilk="function" name="split" returns="list" signature="B.split(sep=None, maxsplit=-1) -&gt; list of bytes" />
        <scope doc="x.__mul__(n) &lt;==&gt; x*n" ilk="function" name="__mul__" signature="x.__mul__(n) &lt;==&gt; x*n" />
        <scope doc="Search for the separator sep in B, starting at the end of B,&#10;and return the part before it, the separator itself, and the&#10;part after it. If the separator is not found, returns two&#10;empty bytes objects and B." ilk="function" name="rpartition" signature="B.rpartition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Return True if B is a titlecased string and there is at&#10;least one character in B, i.e. uppercase characters may only&#10;follow uncased characters and lowercase characters only&#10;cased ones." ilk="function" name="istitle" returns="bool" signature="B.istitle() -&gt; bool" />
        <scope doc="B.__sizeof__() -&gt; size of B in memory, in bytes" ilk="function" name="__sizeof__" signature="B.__sizeof__() -&gt; size of B in memory, in bytes" />
        <scope doc="Return True if all characters in B are alphanumeric and&#10;there is at least one character in B, False otherwise." ilk="function" name="isalnum" returns="bool" signature="B.isalnum() -&gt; bool" />
        <scope doc="Return a copy of B with all occurrences of subsection old&#10;replaced by new. If the optional argument count is given,&#10;only first count occurances are replaced." ilk="function" name="replace" signature="B.replace(old, new[, count]) -&gt; bytes" />
        <scope doc="Return a copy of B with only its first character capitalized&#10;(ASCII) and the rest lower-cased." ilk="function" name="capitalize" signature="B.capitalize() -&gt; copy of B" />
        <scope doc="Return a copy of B, where all characters occurring in the&#10;optional argument deletechars are removed, and the remaining&#10;characters have been mapped through the given translation&#10;table, which must be a bytes object of length 256." ilk="function" name="translate" signature="B.translate(table[, deletechars]) -&gt; bytes" />
        <scope doc="x.__rmul__(n) &lt;==&gt; n*x" ilk="function" name="__rmul__" signature="x.__rmul__(n) &lt;==&gt; n*x" />
        <scope doc="Return a copy of B with all ASCII characters converted to&#10;uppercase." ilk="function" name="upper" signature="B.upper() -&gt; copy of B" />
        <scope doc="Concatenate any number of bytes objects, with B in between&#10;each pair. Example: b'.'.join([b'ab', b'pq', b'rs']) -&gt;&#10;b'ab.pq.rs'." ilk="function" name="join" signature="B.join(iterable_of_bytes) -&gt; bytes" />
        <scope doc="Return B centered in a string of length width. Padding is&#10;done using the specified fill character (default is a&#10;space)." ilk="function" name="center" signature="B.center(width[, fillchar]) -&gt; copy of B" />
        <scope doc="Return the highest index in B where substring sub is found,&#10;such that sub is contained within B[start:end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="rfind" returns="int" signature="B.rfind(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Return a list of the sections in B, using sep as the&#10;delimiter, starting at the end of B and working to the&#10;front. If sep is not given, B is split on ASCII whitespace&#10;characters (space, tab, return, newline, formfeed, vertical&#10;tab)." ilk="function" name="rsplit" returns="list" signature="B.rsplit(sep=None, maxsplit=-1) -&gt; list of bytes" />
        <scope doc="Return B right justified in a string of length width." ilk="function" name="rjust" signature="B.rjust(width[, fillchar]) -&gt; copy of B" />
        <scope doc="x.__contains__(y) &lt;==&gt; y in x" ilk="function" name="__contains__" signature="x.__contains__(y) &lt;==&gt; y in x" />
        <scope doc="Return True if B ends with the specified suffix, False&#10;otherwise. With optional start, test B beginning at that&#10;position." ilk="function" name="endswith" returns="bool" signature="B.endswith(suffix[, start[, end]]) -&gt; bool" />
        <scope ilk="function" name="__getnewargs__" />
        <scope doc="x.__ge__(y) &lt;==&gt; x&gt;=y" ilk="function" name="__ge__" signature="x.__ge__(y) &lt;==&gt; x&gt;=y" />
        <scope doc="Return B left justified in a string of length width. Padding&#10;is done using the specified fill character (default is a&#10;space)." ilk="function" name="ljust" signature="B.ljust(width[, fillchar]) -&gt; copy of B" />
        <scope doc="x.__getitem__(y) &lt;==&gt; x[y]" ilk="function" name="__getitem__" signature="x.__getitem__(y) &lt;==&gt; x[y]" />
        <scope doc="x.__hash__() &lt;==&gt; hash(x)" ilk="function" name="__hash__" signature="x.__hash__() &lt;==&gt; hash(x)" />
        <scope doc="x.__add__(y) &lt;==&gt; x+y" ilk="function" name="__add__" signature="x.__add__(y) &lt;==&gt; x+y" />
        <scope doc="Return True if all characters in B are whitespace and there&#10;is at least one character in B, False otherwise." ilk="function" name="isspace" returns="bool" signature="B.isspace() -&gt; bool" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="Search for the separator sep in B, and return the part&#10;before it, the separator itself, and the part after it. If&#10;the separator is not found, returns B and two empty bytes&#10;objects." ilk="function" name="partition" signature="B.partition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Decode B using the codec registered for encoding. Default&#10;encoding is 'utf-8'." ilk="function" name="decode" returns="str" signature="B.decode(encoding='utf-8', errors='strict') -&gt; str" />
        <scope doc="Return True if B starts with the specified prefix, False&#10;otherwise. With optional start, test B beginning at that&#10;position." ilk="function" name="startswith" returns="bool" signature="B.startswith(prefix[, start[, end]]) -&gt; bool" />
        <scope doc="Strip leading and trailing bytes contained in the argument.&#10;If the argument is omitted, strip leading and trailing ASCII&#10;whitespace." ilk="function" name="strip" signature="B.strip([bytes]) -&gt; bytes" />
        <scope doc="Return a copy of B with uppercase ASCII characters converted&#10;to lowercase ASCII and vice versa." ilk="function" name="swapcase" signature="B.swapcase() -&gt; copy of B" />
      </scope>
      <scope doc="Return whether the object is callable (i.e., some kind of&#10;function). Note that classes are callable, as are instances&#10;of classes with a __call__() method." ilk="function" name="callable" returns="bool" signature="callable(object) -&gt; bool" />
      <scope doc="Return a Unicode string of one character with ordinal i; 0&#10;&lt;= i &lt;= 0x10ffff." ilk="function" name="chr" returns="unicode" signature="chr(i) -&gt; Unicode character" />
      <scope classrefs="object" doc="classmethod(function) -&gt; method&#10;Convert a function to be a class method.  A class method receives the class as implicit first argument, just like an instance method receives the instance. To declare a class method, use this idiom:  class C: def f(cls, arg1, arg2, ...): ... f = classmethod(f) " ilk="class" name="classmethod">
        <scope doc="descr.__get__(obj[, type]) -&gt; value" ilk="function" name="__get__" signature="descr.__get__(obj[, type]) -&gt; value" />
        <scope ilk="function" name="__init__" />
      </scope>
      <scope doc="Compile the source string (a Python module, statement or&#10;expression) into a code object that can be executed by&#10;exec() or eval(). The filename will be used for run-time&#10;error messages." ilk="function" name="compile" returns="code" signature="compile(source, filename, mode[, flags[, dont_inherit]]) -&gt; code object" />
      <scope classrefs="object" doc="complex(real[, imag]) -&gt; complex number&#10;Create a complex number from a real part and an optional imaginary part. This is equivalent to (real + imag*1j) where imag defaults to 0." ilk="class" name="complex">
        <scope doc="x.__le__(y) &lt;==&gt; x&lt;=y" ilk="function" name="__le__" signature="x.__le__(y) &lt;==&gt; x&lt;=y" />
        <scope doc="x.__ne__(y) &lt;==&gt; x!=y" ilk="function" name="__ne__" signature="x.__ne__(y) &lt;==&gt; x!=y" />
        <scope doc="x.__float__() &lt;==&gt; float(x)" ilk="function" name="__float__" signature="x.__float__() &lt;==&gt; float(x)" />
        <scope doc="x.__pow__(y[, z]) &lt;==&gt; pow(x, y[, z])" ilk="function" name="__pow__" signature="x.__pow__(y[, z]) &lt;==&gt; pow(x, y[, z])" />
        <scope doc="x.__rdivmod__(y) &lt;==&gt; divmod(y, x)" ilk="function" name="__rdivmod__" signature="x.__rdivmod__(y) &lt;==&gt; divmod(y, x)" />
        <scope doc="y.__rpow__(x[, z]) &lt;==&gt; pow(x, y[, z])" ilk="function" name="__rpow__" signature="y.__rpow__(x[, z]) &lt;==&gt; pow(x, y[, z])" />
        <scope doc="x.__eq__(y) &lt;==&gt; x==y" ilk="function" name="__eq__" signature="x.__eq__(y) &lt;==&gt; x==y" />
        <scope doc="x.__neg__() &lt;==&gt; -x" ilk="function" name="__neg__" signature="x.__neg__() &lt;==&gt; -x" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="x.__gt__(y) &lt;==&gt; x&gt;y" ilk="function" name="__gt__" signature="x.__gt__(y) &lt;==&gt; x&gt;y" />
        <scope doc="x.__rsub__(y) &lt;==&gt; y-x" ilk="function" name="__rsub__" signature="x.__rsub__(y) &lt;==&gt; y-x" />
        <scope doc="x.__mul__(y) &lt;==&gt; x*y" ilk="function" name="__mul__" signature="x.__mul__(y) &lt;==&gt; x*y" />
        <scope ilk="function" name="__getnewargs__" />
        <scope doc="x.__pos__() &lt;==&gt; +x" ilk="function" name="__pos__" signature="x.__pos__() &lt;==&gt; +x" />
        <scope doc="x.__ge__(y) &lt;==&gt; x&gt;=y" ilk="function" name="__ge__" signature="x.__ge__(y) &lt;==&gt; x&gt;=y" />
        <scope doc="x.__lt__(y) &lt;==&gt; x&lt;y" ilk="function" name="__lt__" signature="x.__lt__(y) &lt;==&gt; x&lt;y" />
        <scope doc="x.__floordiv__(y) &lt;==&gt; x//y" ilk="function" name="__floordiv__" signature="x.__floordiv__(y) &lt;==&gt; x//y" />
        <scope doc="x.__sub__(y) &lt;==&gt; x-y" ilk="function" name="__sub__" signature="x.__sub__(y) &lt;==&gt; x-y" />
        <scope doc="x.__mod__(y) &lt;==&gt; x%y" ilk="function" name="__mod__" signature="x.__mod__(y) &lt;==&gt; x%y" />
        <scope doc="Converts to a string according to format_spec." ilk="function" name="__format__" returns="str" signature="complex.__format__() -&gt; str" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="x.__rmul__(y) &lt;==&gt; y*x" ilk="function" name="__rmul__" signature="x.__rmul__(y) &lt;==&gt; y*x" />
        <scope doc="x.__truediv__(y) &lt;==&gt; x/y" ilk="function" name="__truediv__" signature="x.__truediv__(y) &lt;==&gt; x/y" />
        <scope doc="x.__hash__() &lt;==&gt; hash(x)" ilk="function" name="__hash__" signature="x.__hash__() &lt;==&gt; hash(x)" />
        <scope doc="Returns the complex conjugate of its argument.&#10;(3-4j).conjugate() == 3+4j." ilk="function" name="conjugate" returns="complex" signature="complex.conjugate() -&gt; complex" />
        <scope doc="x.__add__(y) &lt;==&gt; x+y" ilk="function" name="__add__" signature="x.__add__(y) &lt;==&gt; x+y" />
        <scope doc="x.__rfloordiv__(y) &lt;==&gt; y//x" ilk="function" name="__rfloordiv__" signature="x.__rfloordiv__(y) &lt;==&gt; y//x" />
        <scope doc="x.__rtruediv__(y) &lt;==&gt; y/x" ilk="function" name="__rtruediv__" signature="x.__rtruediv__(y) &lt;==&gt; y/x" />
        <scope doc="x.__rmod__(y) &lt;==&gt; y%x" ilk="function" name="__rmod__" signature="x.__rmod__(y) &lt;==&gt; y%x" />
        <scope doc="x.__abs__() &lt;==&gt; abs(x)" ilk="function" name="__abs__" signature="x.__abs__() &lt;==&gt; abs(x)" />
        <scope doc="x.__bool__() &lt;==&gt; x != 0" ilk="function" name="__bool__" signature="x.__bool__() &lt;==&gt; x != 0" />
        <scope doc="x.__int__() &lt;==&gt; int(x)" ilk="function" name="__int__" signature="x.__int__() &lt;==&gt; int(x)" />
