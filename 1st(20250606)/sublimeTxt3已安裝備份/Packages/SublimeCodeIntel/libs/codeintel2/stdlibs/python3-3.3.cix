        <scope doc="x.__iter__() &lt;==&gt; iter(x)" ilk="function" name="__iter__" signature="x.__iter__() &lt;==&gt; iter(x)" />
        <scope doc="Append all the elements from the iterator or sequence to the&#10;end of B." ilk="function" name="extend" signature="B.extend(iterable_of_ints) -&gt; None" />
        <scope doc="Return the number of non-overlapping occurrences of&#10;subsection sub in bytes B[start:end]. Optional arguments&#10;start and end are interpreted as in slice notation." ilk="function" name="count" returns="int" signature="B.count(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__gt__(y) &lt;==&gt; x&gt;y" ilk="function" name="__gt__" signature="x.__gt__(y) &lt;==&gt; x&gt;y" />
        <scope doc="x.__imul__(y) &lt;==&gt; x*=y" ilk="function" name="__imul__" signature="x.__imul__(y) &lt;==&gt; x*=y" />
        <scope doc="Return B left justified in a string of length width. Padding&#10;is done using the specified fill character (default is a&#10;space)." ilk="function" name="ljust" signature="B.ljust(width[, fillchar]) -&gt; copy of B" />
        <scope doc="Like B.find() but raise ValueError when the subsection is&#10;not found." ilk="function" name="index" returns="int" signature="B.index(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__lt__(y) &lt;==&gt; x&lt;y" ilk="function" name="__lt__" signature="x.__lt__(y) &lt;==&gt; x&lt;y" />
        <scope doc="Remove and return a single item from B. If no index argument&#10;is given, will pop the last value." ilk="function" name="pop" returns="int" signature="B.pop([index]) -&gt; int" />
        <scope doc="Strip leading bytes contained in the argument and return the&#10;result as a new bytearray. If the argument is omitted, strip&#10;leading ASCII whitespace." ilk="function" name="lstrip" signature="B.lstrip([bytes]) -&gt; bytearray" />
        <scope doc="Return a copy of B where all tab characters are expanded&#10;using spaces. If tabsize is not given, a tab size of 8&#10;characters is assumed." ilk="function" name="expandtabs" signature="B.expandtabs([tabsize]) -&gt; copy of B" />
        <scope doc="Pad a numeric string B with zeros on the left, to fill a&#10;field of the specified width. B is never truncated." ilk="function" name="zfill" signature="B.zfill(width) -&gt; copy of B" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="Return True if all characters in B are alphabetic and there&#10;is at least one character in B, False otherwise." ilk="function" name="isalpha" returns="bool" signature="B.isalpha() -&gt; bool" />
        <scope doc="Return True if all cased characters in B are lowercase and&#10;there is at least one cased character in B, False otherwise." ilk="function" name="islower" returns="bool" signature="B.islower() -&gt; bool" />
        <scope doc="Return a copy of B with all ASCII characters converted to&#10;lowercase." ilk="function" name="lower" signature="B.lower() -&gt; copy of B" />
        <scope doc="Return a list of the sections in B, using sep as the&#10;delimiter. If sep is not given, B is split on ASCII&#10;whitespace characters (space, tab, return, newline,&#10;formfeed, vertical tab)." ilk="function" name="split" returns="list" signature="B.split(sep=None, maxsplit=-1) -&gt; list of bytearrays" />
        <scope doc="Return the lowest index in B where subsection sub is found,&#10;such that sub is contained within B[start,end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="find" returns="int" signature="B.find(sub[, start[, end]]) -&gt; int" />
        <scope doc="Remove the first occurrence of a value in B." ilk="function" name="remove" signature="B.remove(int) -&gt; None" />
        <scope doc="Search for the separator sep in B, starting at the end of B,&#10;and return the part before it, the separator itself, and the&#10;part after it. If the separator is not found, returns two&#10;empty bytearray objects and B." ilk="function" name="rpartition" signature="B.rpartition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Return state information for pickling." ilk="function" name="__reduce__" />
        <scope doc="x.__mul__(n) &lt;==&gt; x*n" ilk="function" name="__mul__" signature="x.__mul__(n) &lt;==&gt; x*n" />
        <scope doc="Remove all items from B." ilk="function" name="clear" signature="B.clear() -&gt; None" />
        <scope doc="Return True if all characters in B are alphanumeric and&#10;there is at least one character in B, False otherwise." ilk="function" name="isalnum" returns="bool" signature="B.isalnum() -&gt; bool" />
        <scope doc="Return a copy of B with all occurrences of subsection old&#10;replaced by new. If the optional argument count is given,&#10;only the first count occurrences are replaced." ilk="function" name="replace" signature="B.replace(old, new[, count]) -&gt; bytearray" />
        <scope doc="Return a copy of B with only its first character capitalized&#10;(ASCII) and the rest lower-cased." ilk="function" name="capitalize" signature="B.capitalize() -&gt; copy of B" />
        <scope doc="Reverse the order of the values in B in place." ilk="function" name="reverse" signature="B.reverse() -&gt; None" />
        <scope doc="x.__iadd__(y) &lt;==&gt; x+=y" ilk="function" name="__iadd__" signature="x.__iadd__(y) &lt;==&gt; x+=y" />
        <scope doc="x.__rmul__(n) &lt;==&gt; n*x" ilk="function" name="__rmul__" signature="x.__rmul__(n) &lt;==&gt; n*x" />
        <scope doc="Return a copy of B with all ASCII characters converted to&#10;uppercase." ilk="function" name="upper" signature="B.upper() -&gt; copy of B" />
        <scope doc="Append a single item to the end of B." ilk="function" name="append" signature="B.append(int) -&gt; None" />
        <scope doc="Concatenate any number of bytes/bytearray objects, with B in&#10;between each pair, and return the result as a new bytearray." ilk="function" name="join" signature="B.join(iterable_of_bytes) -&gt; bytearray" />
        <scope doc="Return B centered in a string of length width. Padding is&#10;done using the specified fill character (default is a&#10;space)." ilk="function" name="center" signature="B.center(width[, fillchar]) -&gt; copy of B" />
        <scope doc="x.__setitem__(i, y) &lt;==&gt; x[i]=y" ilk="function" name="__setitem__" signature="x.__setitem__(i, y) &lt;==&gt; x[i]=y" />
        <scope doc="Return the highest index in B where subsection sub is found,&#10;such that sub is contained within B[start,end]. Optional&#10;arguments start and end are interpreted as in slice&#10;notation." ilk="function" name="rfind" returns="int" signature="B.rfind(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Return a list of the sections in B, using sep as the&#10;delimiter, starting at the end of B and working to the&#10;front. If sep is not given, B is split on ASCII whitespace&#10;characters (space, tab, return, newline, formfeed, vertical&#10;tab)." ilk="function" name="rsplit" returns="list" signature="B.rsplit(sep=None, maxsplit=-1) -&gt; list of bytearrays" />
        <scope doc="Return B right justified in a string of length width." ilk="function" name="rjust" signature="B.rjust(width[, fillchar]) -&gt; copy of B" />
        <scope ilk="function" name="__init__" />
        <scope doc="x.__contains__(y) &lt;==&gt; y in x" ilk="function" name="__contains__" signature="x.__contains__(y) &lt;==&gt; y in x" />
        <scope doc="Return True if B ends with the specified suffix, False&#10;otherwise. With optional start, test B beginning at that&#10;position." ilk="function" name="endswith" returns="bool" signature="B.endswith(suffix[, start[, end]]) -&gt; bool" />
        <scope doc="Return a copy of B, where all characters occurring in the&#10;optional argument deletechars are removed, and the remaining&#10;characters have been mapped through the given translation&#10;table, which must be a bytes object of length 256." ilk="function" name="translate" signature="B.translate(table[, deletechars]) -&gt; bytearray" />
        <scope doc="Return True if B starts with the specified prefix, False&#10;otherwise. With optional start, test B beginning at that&#10;position." ilk="function" name="startswith" returns="bool" signature="B.startswith(prefix[, start[, end]]) -&gt; bool" />
        <scope doc="x.__ge__(y) &lt;==&gt; x&gt;=y" ilk="function" name="__ge__" signature="x.__ge__(y) &lt;==&gt; x&gt;=y" />
        <scope doc="Return state information for pickling." ilk="function" name="__reduce_ex__" />
        <scope doc="Return the number of bytes actually allocated." ilk="function" name="__alloc__" returns="int" signature="B.__alloc__() -&gt; int" />
        <scope doc="Return a list of the lines in B, breaking at line&#10;boundaries. Line breaks are not included in the resulting&#10;list unless keepends is given and true." ilk="function" name="splitlines" returns="list" signature="B.splitlines([keepends]) -&gt; list of lines" />
        <scope doc="Return a copy of B." ilk="function" name="copy" signature="B.copy() -&gt; bytearray" />
        <scope doc="Like B.rfind() but raise ValueError when the subsection is&#10;not found." ilk="function" name="rindex" returns="int" signature="B.rindex(sub[, start[, end]]) -&gt; int" />
        <scope doc="x.__add__(y) &lt;==&gt; x+y" ilk="function" name="__add__" signature="x.__add__(y) &lt;==&gt; x+y" />
        <scope doc="Return True if all characters in B are whitespace and there&#10;is at least one character in B, False otherwise." ilk="function" name="isspace" returns="bool" signature="B.isspace() -&gt; bool" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="Search for the separator sep in B, and return the part&#10;before it, the separator itself, and the part after it. If&#10;the separator is not found, returns B and two empty&#10;bytearray objects." ilk="function" name="partition" signature="B.partition(sep) -&gt; (head, sep, tail)" />
        <scope doc="Decode B using the codec registered for encoding. Default&#10;encoding is 'utf-8'." ilk="function" name="decode" returns="str" signature="B.decode(encoding='utf-8', errors='strict') -&gt; str" />
        <scope doc="Return True if B is a titlecased string and there is at&#10;least one character in B, i.e. uppercase characters may only&#10;follow uncased characters and lowercase characters only&#10;cased ones." ilk="function" name="istitle" returns="bool" signature="B.istitle() -&gt; bool" />
        <scope doc="Strip leading and trailing bytes contained in the argument&#10;and return the result as a new bytearray. If the argument is&#10;omitted, strip ASCII whitespace." ilk="function" name="strip" signature="B.strip([bytes]) -&gt; bytearray" />
        <scope doc="Return a copy of B with uppercase ASCII characters converted&#10;to lowercase ASCII and vice versa." ilk="function" name="swapcase" signature="B.swapcase() -&gt; copy of B" />
      </scope>
