      <variable citdl="list" line="15" name="EXTENSION_SUFFIXES" />
      <scope classrefs="object" doc="Loader for extension modules.&#10;The constructor is designed to work with FileFinder." ilk="class" name="ExtensionFileLoader">
        <scope doc="Load an extension module." ilk="function" name="load_module" signature="load_module(self, name=None, *args, **kwargs)" />
        <scope doc="Return None as extension modules have no source code." ilk="function" name="get_source" signature="get_source(self, fullname)" />
        <scope doc="Return False as an extension module can never be a package." ilk="function" name="is_package" signature="is_package(self, fullname)" />
        <scope doc="Return None as an extension module cannot create a code&#10;object." ilk="function" name="get_code" signature="get_code(self, fullname)" />
