      <import module="st" />
      <scope doc="Start a file with its associatedapplication.  When&#10;&quot;operation&quot; is not specified or &quot;open&quot;, this acts like&#10;double-clicking the file in Explorer, or giving the file&#10;name as an argument to the DOS &quot;start&quot; command: the file is&#10;opened with whatever application (if any) its extension is&#10;associated. When another &quot;operation&quot; is given, it specifies&#10;what should be done with the file.  A typical operation is&#10;&quot;print&quot;.  startfile returns as soon as the associated&#10;application is launched." ilk="function" name="startfile" signature="startfile(filepath [, operation])" />
      <scope doc="Perform a stat system call on the given path. path may be&#10;specified as either a string or as an open file descriptor." ilk="function" name="stat" signature="stat(path, *, dir_fd=None, follow_symlinks=True) -&gt; stat result" />
      <scope doc="Determine whether os.[lf]stat represents time stamps as&#10;float objects. If newval is True, future calls to stat()&#10;return floats, if it is False, future calls return ints." ilk="function" name="stat_float_times" signature="stat_float_times([newval]) -&gt; oldval" />
      <scope classrefs="tuple" doc="stat_result: Result from stat, fstat, or lstat.&#10;This object may be accessed either as a tuple of (mode, ino, dev, nlink, uid, gid, size, atime, mtime, ctime) or via the attributes st_mode, st_ino, st_dev, st_nlink, st_uid, and so on.  Posix/windows: If your platform supports st_blksize, st_blocks, st_rdev, or st_flags, they are available as attributes only.  See os.stat for more information." ilk="class" name="stat_result">
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
