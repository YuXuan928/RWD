      <scope classrefs="Menubutton" doc="OptionMenu which allows the user to select a value from a menu." ilk="class" name="OptionMenu">
        <scope doc="Destroy this widget and the associated menu." ilk="function" name="destroy" signature="destroy(self)" />
        <scope doc="Construct an optionmenu widget with the parent MASTER,&#10;withthe resource textvariable set to VARIABLE, the initially&#10;selected value VALUE, the other menu values VALUES and an&#10;additional keyword argument command." ilk="function" name="__init__" signature="__init__(self, master, variable, value, *values, **kwargs)" />
        <scope ilk="function" name="__getitem__" signature="__getitem__(self, name)" />
      </scope>
