        <scope doc="Populate the various data structures that keep tabs on&#10;theoption table. Called by 'getopt()' before it can do&#10;anything worthwhile." ilk="function" name="_grok_option_table" signature="_grok_option_table(self)" />
        <scope ilk="function" name="__init__" signature="__init__(self, option_table=None)" />
