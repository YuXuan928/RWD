        <scope doc="x.__pow__(y[, z]) &lt;==&gt; pow(x, y[, z])" ilk="function" name="__pow__" signature="x.__pow__(y[, z]) &lt;==&gt; pow(x, y[, z])" />
        <scope doc="x.__truediv__(y) &lt;==&gt; x/y" ilk="function" name="__truediv__" signature="x.__truediv__(y) &lt;==&gt; x/y" />
        <scope doc="Normalize the number by stripping the rightmost&#10;trailingzeros and converting any result equal to&#10;Decimal('0') to Decimal('0e0'). Used for producing canonical&#10;values for members of an equivalence class. For example,&#10;Decimal('32.100') and Decimal('0.321000e+2') both normalize&#10;to the equivalent value Decimal('32.1')." ilk="function" name="normalize" signature="normalize([context])" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="Identical to compare, except thatall NaNs signal." ilk="function" name="compare_signal" signature="compare_signal(other[, context])" />
        <scope doc="Return True if the argument is subnormal, and&#10;Falseotherwise. A number is subnormal if it is non-zero,&#10;finite, and has an adjusted exponent less than Emin." ilk="function" name="is_subnormal" signature="is_subnormal([context])" />
        <scope doc="Similar to the min() method, but the comparison isdone using&#10;the absolute values of the operands." ilk="function" name="min_mag" signature="min_mag(other[, context])" />
        <scope ilk="function" name="__complex__" />
        <scope doc="x.__mul__(y) &lt;==&gt; x*y" ilk="function" name="__mul__" signature="x.__mul__(y) &lt;==&gt; x*y" />
        <scope doc="Return the natural (base e) logarithm of the operand.The&#10;function always uses the ROUND_HALF_EVEN mode and the result&#10;is correctly rounded." ilk="function" name="ln" signature="ln([context])" />
        <scope doc="Return the result of shifting the digits ofthe first operand&#10;by an amount specified by the second operand. The second&#10;operand must be an integer in the range -precision through&#10;precision. The absolute value of the second operand gives&#10;the number of places to shift. If the second operand is&#10;positive, then the shift is to the left; otherwise the shift&#10;is to the right. Digits shifted into the coefficient are&#10;zeros. The sign and exponent of the first operand are&#10;unchanged." ilk="function" name="shift" signature="shift(other[, context])" />
        <scope doc="x.__ge__(y) &lt;==&gt; x&gt;=y" ilk="function" name="__ge__" signature="x.__ge__(y) &lt;==&gt; x&gt;=y" />
        <scope doc="x.__divmod__(y) &lt;==&gt; divmod(x, y)" ilk="function" name="__divmod__" signature="x.__divmod__(y) &lt;==&gt; divmod(x, y)" />
