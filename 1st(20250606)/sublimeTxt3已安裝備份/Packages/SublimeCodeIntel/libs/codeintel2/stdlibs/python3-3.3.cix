      <scope classrefs="dict" doc="Dict subclass for counting hashable items.  Sometimes called a bagor multiset.  Elements are stored as dictionary keys and their counts are stored as dictionary values.  &gt;&gt;&gt; c = Counter('abcdeabcdabcaba')  # count elements from a string  &gt;&gt;&gt; c.most_common(3)                # three most common elements [('a', 5), ('b', 4), ('c', 3)] &gt;&gt;&gt; sorted(c)                       # list all unique elements ['a', 'b', 'c', 'd', 'e'] &gt;&gt;&gt; ''.join(sorted(c.elements()))   # list elements with repetitions" ilk="class" line="404" lineend="756" name="Counter">
