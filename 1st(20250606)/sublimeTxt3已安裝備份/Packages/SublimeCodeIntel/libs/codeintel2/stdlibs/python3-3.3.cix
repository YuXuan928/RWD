      <scope classrefs="object" doc="socket([family[, type[, proto]]]) -&gt; socket object&#10;Open a socket of the given type.  The family argument specifies the address family; it defaults to AF_INET.  The type argument specifies whether this is a stream (SOCK_STREAM, this is the default) or datagram (SOCK_DGRAM) socket.  The protocol argument defaults to 0, specifying the default protocol.  Keyword arguments are accepted.  A socket object represents one endpoint of a network connection.  Methods of socket objects (keyword arguments not allowed): " ilk="class" name="SocketType">
        <scope doc="Set a timeout on socket operations. 'timeout' can be a&#10;float, giving in seconds, or None." ilk="function" name="settimeout" signature="settimeout(timeout)" />
        <scope doc="Like recv(buffersize, flags) but also return the sender's&#10;address info." ilk="function" name="recvfrom" signature="recvfrom(buffersize[, flags]) -&gt; (data, address info)" />
        <scope doc="Return the integer file descriptor of the socket." ilk="function" name="fileno" returns="int" signature="fileno() -&gt; integer" />
        <scope doc="Like recv_into(buffer[, nbytes[, flags]]) but also return&#10;the sender's address info." ilk="function" name="recvfrom_into" signature="recvfrom_into(buffer[, nbytes[, flags]]) -&gt; (nbytes, address info)" />
        <scope doc="Get a socket option. See the Unix manual for level and&#10;option." ilk="function" name="getsockopt" signature="getsockopt(level, option[, buffersize]) -&gt; value" />
        <scope doc="Return the address of the remote endpoint. For IP sockets,&#10;the address info is a pair (hostaddr, port)." ilk="function" name="getpeername" signature="getpeername() -&gt; address info" />
        <scope doc="Close the socket. It cannot be used after this call." ilk="function" name="close" signature="close()" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Set the socket to blocking (flag is true) or non-blocking&#10;(false). setblocking(True) is equivalent to&#10;settimeout(None); setblocking(False) is equivalent to&#10;settimeout(0.0)." ilk="function" name="setblocking" signature="setblocking(flag)" />
        <scope doc="Send a data string to the socket. For the optional flags&#10;argument, see the Unix manual." ilk="function" name="sendall" signature="sendall(data[, flags])" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope ilk="function" name="__init__" />
        <scope doc="Wait for an incoming connection. Return a new socket file&#10;descriptor representing the connection, and the address of&#10;the client." ilk="function" name="_accept" signature="_accept() -&gt; (integer, address info)" />
        <scope doc="Close the socket object without closing the underlying file&#10;descriptor.The object cannot be used after this call, but&#10;the file descriptorcan be reused for other purposes. The&#10;file descriptor is returned." ilk="function" name="detach" signature="detach()" />
        <scope doc="Set a socket option. See the Unix manual for level and&#10;option." ilk="function" name="setsockopt" signature="setsockopt(level, option, value)" />
        <scope doc="Return the address of the local endpoint. For IP sockets,&#10;the address info is a pair (hostaddr, port)." ilk="function" name="getsockname" signature="getsockname() -&gt; address info" />
        <scope doc="Like send(data, flags) but allows specifying the destination&#10;address. For IP sockets, the address is a pair (hostaddr,&#10;port)." ilk="function" name="sendto" signature="sendto(data[, flags], address) -&gt; count" />
        <scope doc="Receive up to buffersize bytes from the socket. For the&#10;optional flags argument, see the Unix manual." ilk="function" name="recv" signature="recv(buffersize[, flags]) -&gt; data" />
        <scope doc="Send a data string to the socket. For the optional flags&#10;argument, see the Unix manual." ilk="function" name="send" signature="send(data[, flags]) -&gt; count" />
        <scope doc="A version of recv() that stores its data into a buffer&#10;rather than creating a new string. Receive up to buffersize&#10;bytes from the socket." ilk="function" name="recv_into" signature="recv_into(buffer, [nbytes[, flags]]) -&gt; nbytes_read" />
        <scope doc="Bind the socket to a local address. For IP sockets, the&#10;address is a pair (host, port); the host must refer to the&#10;local host." ilk="function" name="bind" signature="bind(address)" />
        <scope doc="Connect the socket to a remote address. For IP sockets, the&#10;address is a pair (host, port)." ilk="function" name="connect" signature="connect(address)" />
        <scope doc="Control the socket with WSAIoctl syscall. Currently&#10;supported 'cmd' values are SIO_RCVALL:  'option' must be one&#10;of the socket.RCVALL_* constants." ilk="function" name="ioctl" returns="long" signature="ioctl(cmd, option) -&gt; long" />
        <scope doc="Enable a server to accept connections. The backlog argument&#10;must be at least 0 (if it is lower, it is set to 0); it&#10;specifies the number of unaccepted connections that the&#10;system will allow before refusing new connections." ilk="function" name="listen" signature="listen(backlog)" />
        <scope doc="Share the socket with another process. The target process id&#10;must be provided and the resulting bytes object passed to&#10;the target process." ilk="function" name="share" signature="share(process_id) -&gt; bytes" />
        <scope doc="Shut down the reading side of the socket (flag == SHUT_RD),&#10;the writing side of the socket (flag == SHUT_WR), or both&#10;ends (flag == SHUT_RDWR)." ilk="function" name="shutdown" signature="shutdown(flag)" />
