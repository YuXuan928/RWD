        <scope doc="Convert the array to an array of machine values and return&#10;the bytes representation." ilk="function" name="tobytes" signature="tobytes() -&gt; bytes" />
        <scope doc="Convert the array to a unicode string. The array must be a&#10;unicode type array; otherwise a ValueError is raised." ilk="function" name="tounicode" returns="unicode" signature="tounicode() -&gt; unicode" />
        <scope doc="Insert a new item x into the array before position i." ilk="function" name="insert" signature="insert(i,x)" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Read n objects from the file object f and append them to the&#10;end of the array." ilk="function" name="fromfile" signature="fromfile(f, n)" />
        <scope doc="x.__delitem__(y) &lt;==&gt; del x[y]" ilk="function" name="__delitem__" signature="x.__delitem__(y) &lt;==&gt; del x[y]" />
        <scope doc="x.__len__() &lt;==&gt; len(x)" ilk="function" name="__len__" signature="x.__len__() &lt;==&gt; len(x)" />
