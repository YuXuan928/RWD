        <scope doc="Return a new PhotoImage based on the same image as this&#10;widgetbut use only every Xth or Yth pixel." ilk="function" name="subsample" signature="subsample(self, x, y='')" />
        <scope doc="Return the color (red, green, blue) of the pixel at X,Y." ilk="function" name="get" signature="get(self, x, y)" />
