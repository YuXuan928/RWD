    <scope doc="Functions to convert between Python values and C structs.Python bytes objects are used to hold the data representing the C struct and also as format strings (explained below) to describe the layout of data in the C struct.  The optional first format char indicates byte order, size and alignment: @: native order, size &amp; alignment (default) =: native order, std. size &amp; alignment &lt;: little-endian, std. size &amp; alignment &gt;: big-endian, std. size &amp; alignment !: same as &gt;" ilk="blob" lang="Python3" name="Lib.struct">
      <scope classrefs="object" doc="Struct(fmt) --&gt; compiled struct object&#10;Return a new Struct object which writes and reads binary data according to the format string fmt.  See help(struct) for more on format strings." ilk="class" name="Struct">
        <scope doc="x.__setattr__('name', value) &lt;==&gt; x.name = value" ilk="function" name="__setattr__" signature="x.__setattr__('name', value) &lt;==&gt; x.name = value" />
        <scope doc="Return a bytes object containing values v1, v2, ... packed&#10;according to the format string S.format." ilk="function" name="pack" signature="S.pack(v1, v2, ...) -&gt; bytes" />
        <scope doc="Return a tuple containing values unpacked according to the&#10;format string S.format. Requires len(buffer) == S.size." ilk="function" name="unpack" signature="S.unpack(buffer) -&gt; (v1, v2, ...)" />
        <scope doc="x.__delattr__('name') &lt;==&gt; del x.name" ilk="function" name="__delattr__" signature="x.__delattr__('name') &lt;==&gt; del x.name" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Return a tuple containing values unpacked according to the&#10;format string S.format. Requires len(buffer[offset:]) &gt;=&#10;S.size." ilk="function" name="unpack_from" signature="S.unpack_from(buffer, offset=0) -&gt; (v1, v2, ...)" />
        <scope ilk="function" name="__init__" />
        <scope doc="Pack the values v1, v2, ... according to the format string&#10;S.format and write the packed bytes into the writable buffer&#10;buf starting at offset." ilk="function" name="pack_into" signature="S.pack_into(buffer, offset, v1, v2, ...)" />
      </scope>
      <variable citdl="list" line="1" name="__all__" />
