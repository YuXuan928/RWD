    <scope doc="Functions to convert between Python values and C structs.Python bytes objects are used to hold the data representing the C struct and also as format strings (explained below) to describe the layout of data in the C struct.  The optional first format char indicates byte order, size and alignment: @: native order, size &amp; alignment (default) =: native order, std. size &amp; alignment &lt;: little-endian, std. size &amp; alignment &gt;: big-endian, std. size &amp; alignment !: same as &gt;" ilk="blob" lang="Python3" name="struct">
      <scope classrefs="object" doc="Struct(fmt) --&gt; compiled struct object&#10;Return a new Struct object which writes and reads binary data according to the format string fmt.  See help(struct) for more on format strings." ilk="class" name="Struct">
        <scope doc="x.__setattr__('name', value) &lt;==&gt; x.name = value" ilk="function" name="__setattr__" signature="x.__setattr__('name', value) &lt;==&gt; x.name = value" />
        <scope doc="Return a bytes object containing values v1, v2, ... packed&#10;according to the format string S.format." ilk="function" name="pack" signature="S.pack(v1, v2, ...) -&gt; bytes" />
        <scope doc="Return a tuple containing values unpacked according to the&#10;format string S.format. Requires len(buffer) == S.size." ilk="function" name="unpack" signature="S.unpack(buffer) -&gt; (v1, v2, ...)" />
        <scope doc="x.__delattr__('name') &lt;==&gt; del x.name" ilk="function" name="__delattr__" signature="x.__delattr__('name') &lt;==&gt; del x.name" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Return a tuple containing values unpacked according to the&#10;format string S.format. Requires len(buffer[offset:]) &gt;=&#10;S.size." ilk="function" name="unpack_from" signature="S.unpack_from(buffer, offset=0) -&gt; (v1, v2, ...)" />
        <scope ilk="function" name="__init__" />
        <scope doc="Pack the values v1, v2, ... according to the format string&#10;S.format and write the packed bytes into the writable buffer&#10;buf starting at offset." ilk="function" name="pack_into" signature="S.pack_into(buffer, offset, v1, v2, ...)" />
      </scope>
      <variable citdl="list" line="1" name="__all__" />
      <variable citdl="SourceFileLoader" name="__loader__" />
      <scope doc="Return size in bytes of the struct described by the format&#10;string fmt." ilk="function" name="calcsize" returns="int" signature="calcsize(fmt) -&gt; integer" />
      <scope classrefs="Exception" doc="&#10;" ilk="class" name="error" />
      <scope doc="Return a bytes object containing the values v1, v2, ...&#10;packed according to the format string fmt." ilk="function" name="pack" signature="pack(fmt, v1, v2, ...) -&gt; bytes" />
      <scope doc="Pack the values v1, v2, ... according to the format string&#10;fmt and write the packed bytes into the writable buffer buf&#10;starting at offset." ilk="function" name="pack_into" signature="pack_into(fmt, buffer, offset, v1, v2, ...)" />
      <scope doc="Return a tuple containing values unpacked according to the&#10;format string fmt. Requires len(buffer) == calcsize(fmt)." ilk="function" name="unpack" signature="unpack(fmt, buffer) -&gt; (v1, v2, ...)" />
      <scope doc="unpack_from(fmt, buffer, offset=0) -&gt; (v1, v2, ...)&#10;Return a tuple containing values unpacked according to the format string fmt.  Requires len(buffer[offset:]) &gt;= calcsize(fmt).  See help(struct) for more on format strings." ilk="function" name="unpack_from" signature="unpack_from(fmt, buffer, offset=0) -&gt; (v1, v2, ...)&#10;calcsize(fmt) -&gt; Return a tuple containing values unpacked according to the format string fmt.  Requires len(buffer[offset:]) &gt;" />
    </scope>
    <scope doc="C decimal arithmetic module" ilk="blob" lang="Python3" name="_decimal">
      <variable citdl="Context" name="BasicContext" />
      <scope classrefs="DecimalException" doc="&#10;" ilk="class" name="Clamped" />
      <scope classrefs="object" doc="The context affects almost all operations and controls rounding,Over/Underflow, raising of exceptions and much more. A new context can be constructed as follows:  &gt;&gt;&gt; c = Context(prec=28, Emin=-425000000, Emax=425000000, ...             rounding=ROUND_HALF_EVEN, capitals=1, clamp=1, ...             traps=[InvalidOperation, DivisionByZero, Overflow], ...             flags=[]) &gt;&gt;&gt;" ilk="class" name="Context">
        <scope doc="Return the smallest representable number larger than x." ilk="function" name="next_plus" signature="next_plus(x)" />
        <scope doc="Return the base 10 logarithm of x." ilk="function" name="log10" signature="log10(x)" />
        <scope doc="Return a copy of x with the sign inverted." ilk="function" name="copy_negate" signature="copy_negate(x)" />
        <scope doc="Square root of a non-negative number to context precision." ilk="function" name="sqrt" signature="sqrt(x)" />
        <scope doc="Compute x**y. If x is negative, then y must be integral.The&#10;result will be inexact unless y is integral and the result&#10;is finite and can be expressed exactly in 'precision'&#10;digits. In the Python version the result is always correctly&#10;rounded, in the C version the result is almost always&#10;correctly rounded.  power(x, y, m) - Compute (x**y) % m. The&#10;following restrictions hold:  * all three arguments must be&#10;integral * y must be nonnegative * at least one of x or y&#10;must be nonzero" ilk="function" name="power" signature="power(x, y)" />
        <scope doc="Return True if x is canonical, False otherwise." ilk="function" name="is_canonical" signature="is_canonical(x)" />
        <scope ilk="function" name="__copy__" />
        <scope doc="Digit-wise or of x and y." ilk="function" name="logical_or" signature="logical_or(x, y)" />
        <scope doc="Return a value equal to Emax - prec + 1. This is the maximum&#10;exponentif the _clamp field of the context is set to 1 (IEEE&#10;clamp mode). Etop() must not be negative." ilk="function" name="Etop" signature="Etop()" />
        <scope doc="Return True if x is a quiet NaN, False otherwise." ilk="function" name="is_qnan" signature="is_qnan(x)" />
        <scope doc="Return the product of x and y." ilk="function" name="multiply" signature="multiply(x, y)" />
        <scope doc="Return True if x is a normal number, False otherwise." ilk="function" name="is_normal" signature="is_normal(x)" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="Convert a number to a string, using engineering notation." ilk="function" name="to_eng_string" signature="to_eng_string(x)" />
        <scope doc="Return the exponent of the magnitude of the operand's MSD." ilk="function" name="logb" signature="logb(x)" />
        <scope doc="Return x - y * n, where n is the integer nearest theexact&#10;value of x / y (if the result is 0 then its sign will be the&#10;sign of x)." ilk="function" name="remainder_near" signature="remainder_near(x, y)" />
        <scope doc="Return True if x is negative, False otherwise." ilk="function" name="is_signed" signature="is_signed(x)" />
        <scope ilk="function" name="__reduce__" />
        <scope doc="Compare the values numerically and return the maximum." ilk="function" name="max" signature="max(x, y)" />
        <scope doc="Return the difference between x and y." ilk="function" name="subtract" signature="subtract(x, y)" />
        <scope doc="Return True if x is a zero, False otherwise." ilk="function" name="is_zero" signature="is_zero(x)" />
        <scope doc="Identical to to_integral_value(x)." ilk="function" name="to_integral" signature="to_integral(x)" />
        <scope doc="Return the natural (base e) logarithm of x." ilk="function" name="ln" signature="ln(x)" />
        <scope doc="Return the remainder from integer division. The sign ofthe&#10;result, if non-zero, is the same as that of the original&#10;dividend." ilk="function" name="remainder" signature="remainder(x, y)" />
        <scope doc="Create a new Decimal instance from float f.Unlike the&#10;Decimal.from_float() class method, this function observes&#10;the context limits." ilk="function" name="create_decimal_from_float" signature="create_decimal_from_float(f)" />
        <scope doc="Convert a number to a string using scientific notation." ilk="function" name="to_sci_string" signature="to_sci_string(x)" />
        <scope doc="Return x divided by y, truncated to an integer." ilk="function" name="divide_int" signature="divide_int(x, y)" />
        <scope doc="Return a value equal to Emin - prec + 1, which is the&#10;minimumexponent value for subnormal results. When underflow&#10;occurs, the exponent is set to Etiny." ilk="function" name="Etiny" signature="Etiny()" />
        <scope doc="Compare the values numerically with their sign ignored." ilk="function" name="max_mag" signature="max_mag(x, y)" />
        <scope ilk="function" name="__init__" />
        <scope doc="Return a copy of x, rotated by y places." ilk="function" name="rotate" signature="rotate(x, y)" />
        <scope doc="Round to an integer." ilk="function" name="to_integral_value" signature="to_integral_value(x)" />
        <scope doc="Compare x and y using their abstract representation,ignoring&#10;sign." ilk="function" name="compare_total_mag" signature="compare_total_mag(x, y)" />
        <scope doc="x.__delattr__('name') &lt;==&gt; del x.name" ilk="function" name="__delattr__" signature="x.__delattr__('name') &lt;==&gt; del x.name" />
        <scope doc="Return a copy of x with the sign set to 0." ilk="function" name="copy_abs" signature="copy_abs(x)" />
        <scope doc="Reset all flags to False." ilk="function" name="clear_flags" signature="clear_flags()" />
        <scope ilk="function" name="_unsafe_setprec" />
        <scope doc="Compare x and y numerically." ilk="function" name="compare" signature="compare(x, y)" />
        <scope doc="Return a duplicate of the context with all flags cleared." ilk="function" name="copy" signature="copy()" />
        <scope doc="Return True if x is infinite, False otherwise." ilk="function" name="is_infinite" signature="is_infinite(x)" />
        <scope doc="Compare x and y using their abstract representation." ilk="function" name="compare_total" signature="compare_total(x, y)" />
        <scope doc="Invert all digits of x." ilk="function" name="logical_invert" signature="logical_invert(x)" />
        <scope doc="x.__setattr__('name', value) &lt;==&gt; x.name = value" ilk="function" name="__setattr__" signature="x.__setattr__('name', value) &lt;==&gt; x.name = value" />
        <scope doc="Return 10." ilk="function" name="radix" signature="radix()" />
        <scope ilk="function" name="_unsafe_setemin" />
        <scope doc="Round to an integer. Signal if the result isrounded or&#10;inexact." ilk="function" name="to_integral_exact" signature="to_integral_exact(x)" />
        <scope doc="Copy the sign from y to x." ilk="function" name="copy_sign" signature="copy_sign(x, y)" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Compare the values numerically and return the minimum." ilk="function" name="min" signature="min(x, y)" />
        <scope doc="Digit-wise xor of x and y." ilk="function" name="logical_xor" signature="logical_xor(x, y)" />
        <scope doc="Return e ** x." ilk="function" name="exp" signature="exp(x)" />
        <scope doc="Return the largest representable number smaller than x." ilk="function" name="next_minus" signature="next_minus(x)" />
        <scope ilk="function" name="_apply" />
        <scope doc="Return True if the two operands have the same exponent." ilk="function" name="same_quantum" signature="same_quantum(x, y)" />
        <scope doc="Return x divided by y." ilk="function" name="divide" signature="divide(x, y)" />
        <scope doc="Plus corresponds to the unary prefix plus operator in&#10;Python,but applies the context to the result." ilk="function" name="plus" signature="plus(x)" />
        <scope doc="Return the sum of x and y." ilk="function" name="add" signature="add(x, y)" />
        <scope doc="Return True if x is finite, False otherwise." ilk="function" name="is_finite" signature="is_finite(x)" />
        <scope doc="Create a new Decimal instance from x, using self as&#10;thecontext. Unlike the Decimal constructor, this function&#10;observes the context limits." ilk="function" name="create_decimal" signature="create_decimal(x)" />
        <scope doc="Return a new instance of x." ilk="function" name="canonical" signature="canonical(x)" />
        <scope doc="Set all traps to False." ilk="function" name="clear_traps" signature="clear_traps()" />
        <scope ilk="function" name="_unsafe_setemax" />
        <scope doc="Return True if x is a signaling NaN, False otherwise." ilk="function" name="is_snan" signature="is_snan()" />
        <scope doc="Return x multiplied by y, plus z." ilk="function" name="fma" signature="fma(x, y, z)" />
        <scope doc="Return a value equal to x (rounded), having the exponent of&#10;y." ilk="function" name="quantize" signature="quantize(x, y)" />
        <scope doc="Return True if x is subnormal, False otherwise." ilk="function" name="is_subnormal" signature="is_subnormal(x)" />
        <scope doc="Reduce x to its simplest form. Alias for reduce(x)." ilk="function" name="normalize" signature="normalize(x)" />
        <scope doc="Return the number closest to x, in the direction towards y." ilk="function" name="next_toward" signature="next_toward(x)" />
        <scope doc="Compare x and y numerically. All NaNs signal." ilk="function" name="compare_signal" signature="compare_signal(x, y)" />
        <scope doc="Compare the values numerically with their sign ignored." ilk="function" name="min_mag" signature="min_mag(x, y)" />
        <scope doc="Return True if x is a qNaN or sNaN, False otherwise." ilk="function" name="is_nan" signature="is_nan(x)" />
        <scope doc="Return a copy of x, shifted by y places." ilk="function" name="shift" signature="shift(x, y)" />
        <scope doc="Return quotient and remainder of the division x / y." ilk="function" name="divmod" signature="divmod(x, y)" />
        <scope doc="Return a copy of Decimal x." ilk="function" name="copy_decimal" signature="copy_decimal(x)" />
        <scope doc="Return an indication of the class of x." ilk="function" name="number_class" signature="number_class(x)" />
        <scope doc="Minus corresponds to the unary prefix minus operator in&#10;Python,but applies the context to the result." ilk="function" name="minus" signature="minus(x)" />
        <scope doc="x.__str__() &lt;==&gt; str(x)" ilk="function" name="__str__" signature="x.__str__() &lt;==&gt; str(x)" />
        <scope doc="Return the first operand after adding the second valueto its&#10;exp." ilk="function" name="scaleb" signature="scaleb(x, y)" />
        <scope doc="Digit-wise and of x and y." ilk="function" name="logical_and" signature="logical_and(x, y)" />
      </scope>
      <scope classrefs="InvalidOperation" doc="&#10;" ilk="class" name="ConversionSyntax" />
      <scope classrefs="object" doc="Decimal([value[, context]]): Construct a new Decimal object from value.&#10;value can be an integer, string, tuple, or another Decimal object. If no value is given, return Decimal('0'). The context does not affect the conversion and is only passed to determine if the InvalidOperation trap is active." ilk="class" name="Decimal">
        <scope doc="x.__le__(y) &lt;==&gt; x&lt;=y" ilk="function" name="__le__" signature="x.__le__(y) &lt;==&gt; x&lt;=y" />
        <scope doc="x.__ne__(y) &lt;==&gt; x!=y" ilk="function" name="__ne__" signature="x.__ne__(y) &lt;==&gt; x!=y" />
        <scope doc="x.__float__() &lt;==&gt; float(x)" ilk="function" name="__float__" signature="x.__float__() &lt;==&gt; float(x)" />
        <scope doc="Return the base ten logarithm of the operand.The function&#10;always uses the ROUND_HALF_EVEN mode and the result is&#10;correctly rounded." ilk="function" name="log10" signature="log10([context])" />
        <scope doc="Return the smallest number representable in the givencontext&#10;(or in the current default context if no context is given)&#10;that is larger than the given operand." ilk="function" name="next_plus" signature="next_plus([context])" />
        <scope doc="x.__rdivmod__(y) &lt;==&gt; divmod(y, x)" ilk="function" name="__rdivmod__" signature="x.__rdivmod__(y) &lt;==&gt; divmod(y, x)" />
        <scope doc="Return the square root of the argument to full precision.The&#10;result is correctly rounded using the ROUND_HALF_EVEN&#10;rounding mode." ilk="function" name="sqrt" signature="sqrt([context])" />
        <scope doc="Return True if the argument is a (positive or negative) zero&#10;andFalse otherwise." ilk="function" name="is_zero" signature="is_zero()" />
        <scope doc="Return True if the argument is canonical and False&#10;otherwise.Currently, a Decimal instance is always canonical,&#10;so this operation always returns True." ilk="function" name="is_canonical" signature="is_canonical()" />
        <scope ilk="function" name="__sizeof__" />
        <scope ilk="function" name="__copy__" />
        <scope doc="Return the digit-wise or of the two(logical) operands." ilk="function" name="logical_or" signature="logical_or(other[, context])" />
        <scope doc="x.__gt__(y) &lt;==&gt; x&gt;y" ilk="function" name="__gt__" signature="x.__gt__(y) &lt;==&gt; x&gt;y" />
        <scope doc="x.__rsub__(y) &lt;==&gt; y-x" ilk="function" name="__rsub__" signature="x.__rsub__(y) &lt;==&gt; y-x" />
        <scope ilk="function" name="__round__" />
        <scope doc="Return True if the argument is a quiet NaN, and False&#10;otherwise." ilk="function" name="is_qnan" signature="is_qnan()" />
        <scope ilk="function" name="__floor__" />
        <scope doc="x.__lt__(y) &lt;==&gt; x&lt;y" ilk="function" name="__lt__" signature="x.__lt__(y) &lt;==&gt; x&lt;y" />
        <scope doc="Return True if the argument is a normal finite non-&#10;zeronumber with an adjusted exponent greater than or equal&#10;to Emin. Return False if the argument is zero, subnormal,&#10;infinite or a NaN." ilk="function" name="is_normal" signature="is_normal([context])" />
        <scope doc="x.__repr__() &lt;==&gt; repr(x)" ilk="function" name="__repr__" signature="x.__repr__() &lt;==&gt; repr(x)" />
        <scope doc="Convert to an engineering-type string.Engineering notation&#10;has an exponent which is a multiple of 3, so there are up to&#10;3 digits left of the decimal place. For example,&#10;Decimal('123E+1') is converted to Decimal('1.23E+3')" ilk="function" name="to_eng_string" signature="to_eng_string([context])" />
        <scope doc="For a non-zero number, return the adjusted exponentof the&#10;operand as a Decimal instance. If the operand is a zero,&#10;then Decimal('-Infinity') is returned and the DivisionByZero&#10;condition is raised. If the operand is an infinity then&#10;Decimal('Infinity') is returned." ilk="function" name="logb" signature="logb([context])" />
        <scope doc="Compute the modulo as either a positiveor negative value&#10;depending on which is closest to zero. For instance,&#10;Decimal(10).remainder_near(6) returns Decimal('-2'), which&#10;is closer to zero than Decimal('4').  If both are equally&#10;close, the one chosen will have the same sign as self." ilk="function" name="remainder_near" signature="remainder_near(other[, context])" />
        <scope doc="Return True if the argument has a negative sign andFalse&#10;otherwise. Note that both zeros and NaNs can carry signs." ilk="function" name="is_signed" signature="is_signed()" />
        <scope doc="Return True if the argument is either positive or&#10;negativeinfinity and False otherwise." ilk="function" name="is_infinite" signature="is_infinite()" />
        <scope doc="y.__rpow__(x[, z]) &lt;==&gt; pow(x, y[, z])" ilk="function" name="__rpow__" signature="y.__rpow__(x[, z]) &lt;==&gt; pow(x, y[, z])" />
        <scope ilk="function" name="__format__" />
        <scope doc="Maximum of self and other. If one operand is a quietNaN and&#10;the other is numeric, the numeric operand is returned." ilk="function" name="max" signature="max(other[, context])" />
        <scope doc="Return the canonical encoding of the argument. Currently,the&#10;encoding of a Decimal instance is always canonical, so this&#10;operation returns its argument unchanged." ilk="function" name="canonical" signature="canonical()" />
        <scope doc="Return a value equal to the firstoperand after rounding and&#10;having the exponent of the second operand.  &gt;&gt;&gt;&#10;Decimal('1.41421356').quantize(Decimal('1.000'))&#10;Decimal('1.414')  Unlike other operations, if the length of&#10;the coefficient after the quantize operation would be&#10;greater than precision, then an InvalidOperation is&#10;signaled. This guarantees that, unless there is an error&#10;condition, the quantized exponent is always equal to that of&#10;the right-hand operand." ilk="function" name="quantize" signature="quantize(exp[, rounding[, context]])" />
        <scope doc="Return True if the argument is a (quiet or signaling) NaN&#10;andFalse otherwise." ilk="function" name="is_nan" signature="is_nan()" />
        <scope doc="If the two operands are unequal, return thenumber closest to&#10;the first operand in the direction of the second operand. If&#10;both operands are numerically equal, return a copy of the&#10;first operand with the sign set to be the same as the sign&#10;of the second operand." ilk="function" name="next_toward" signature="next_toward(other[, context])" />
        <scope doc="x.__pos__() &lt;==&gt; +x" ilk="function" name="__pos__" signature="x.__pos__() &lt;==&gt; +x" />
        <scope doc="x.__getattribute__('name') &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__('name') &lt;==&gt; x.name" />
        <scope doc="Similar to the max() method, but the comparison isdone using&#10;the absolute values of the operands." ilk="function" name="max_mag" signature="max_mag(other[, context])" />
        <scope doc="x.__bool__() &lt;==&gt; x != 0" ilk="function" name="__bool__" signature="x.__bool__() &lt;==&gt; x != 0" />
        <scope doc="Return the result of rotating the digits of thefirst operand&#10;by an amount specified by the second operand. The second&#10;operand must be an integer in the range -precision through&#10;precision. The absolute value of the second operand gives&#10;the number of places to rotate. If the second operand is&#10;positive then rotation is to the left; otherwise rotation is&#10;to the right. The coefficient of the first operand is padded&#10;on the left with zeros to length precision if necessary. The&#10;sign and exponent of the first operand are unchanged." ilk="function" name="rotate" signature="rotate(other[, context])" />
        <scope doc="x.__rmul__(y) &lt;==&gt; y*x" ilk="function" name="__rmul__" signature="x.__rmul__(y) &lt;==&gt; y*x" />
        <scope doc="Round to the nearest integer withoutsignaling Inexact or&#10;Rounded. The rounding mode is determined by the rounding&#10;parameter if given, else by the given context. If neither&#10;parameter is given, then the rounding mode of the current&#10;default context is used." ilk="function" name="to_integral_value" signature="to_integral_value([rounding[, context]])" />
        <scope doc="Return a tuple representation of the number." ilk="function" name="as_tuple" signature="as_tuple()" />
        <scope doc="Return the absolute value of the argument. This operationis&#10;unaffected by the context and is quiet: no flags are changed&#10;and no rounding is performed." ilk="function" name="copy_abs" signature="copy_abs()" />
        <scope doc="x.__mod__(y) &lt;==&gt; x%y" ilk="function" name="__mod__" signature="x.__mod__(y) &lt;==&gt; x%y" />
        <scope doc="x.__abs__() &lt;==&gt; abs(x)" ilk="function" name="__abs__" signature="x.__abs__() &lt;==&gt; abs(x)" />
        <scope doc="Compare self to other. Return a decimal value:" ilk="function" name="compare" signature="compare(other[, context])" />
        <scope doc="x.__hash__() &lt;==&gt; hash(x)" ilk="function" name="__hash__" signature="x.__hash__() &lt;==&gt; hash(x)" />
        <scope doc="Fused multiply-add. Return self*other+thirdwith no rounding&#10;of the intermediate product self*other.  &gt;&gt;&gt;&#10;Decimal(2).fma(3, 5) Decimal('11')" ilk="function" name="fma" signature="fma(other, third[, context])" />
        <scope doc="Compare two operands using their abstractrepresentation&#10;rather than their value as in compare_total(), but ignoring&#10;the sign of each operand.  x.compare_total_mag(y) is&#10;equivalent to x.copy_abs().compare_total(y.copy_abs())." ilk="function" name="compare_total_mag" signature="compare_total_mag(other)" />
        <scope doc="Return the digit-wise inversion of the(logical) operand." ilk="function" name="logical_invert" signature="logical_invert([context])" />
        <scope doc="Return self." ilk="function" name="conjugate" signature="conjugate()" />
        <scope doc="Return Decimal(10), the radix (base) in which the Decimal&#10;class doesall its arithmetic. Included for compatibility&#10;with the specification." ilk="function" name="radix" signature="radix()" />
        <scope doc="Return the digit-wise and of the two(logical) operands." ilk="function" name="logical_and" signature="logical_and(other[, context])" />
        <scope ilk="function" name="__ceil__" />
        <scope doc="Round to the nearest integer,signaling Inexact or Rounded as&#10;appropriate if rounding occurs. The rounding mode is&#10;determined by the rounding parameter if given, else by the&#10;given context. If neither parameter is given, then the&#10;rounding mode of the current default context is used." ilk="function" name="to_integral_exact" signature="to_integral_exact([rounding[, context]])" />
        <scope doc="Return a copy of the first operand with the sign setto be&#10;the same as the sign of the second operand. For example:&#10;&gt;&gt;&gt; Decimal('2.3').copy_sign(Decimal('-1.5'))&#10;Decimal('-2.3')  This operation is unaffected by the context&#10;and is quiet: no flags are changed and no rounding is&#10;performed." ilk="function" name="copy_sign" signature="copy_sign(other)" />
        <scope doc="x.__eq__(y) &lt;==&gt; x==y" ilk="function" name="__eq__" signature="x.__eq__(y) &lt;==&gt; x==y" />
        <scope doc="x.__neg__() &lt;==&gt; -x" ilk="function" name="__neg__" signature="x.__neg__() &lt;==&gt; -x" />
        <scope doc="Return the adjusted exponent of the number." ilk="function" name="adjusted" signature="adjusted()" />
        <scope doc="Return the digit-wise exclusive or of thetwo (logical)&#10;operands." ilk="function" name="logical_xor" signature="logical_xor(other[, context])" />
        <scope doc="Return the value of the (natural) exponential function&#10;e**xat the given number. The function always uses the&#10;ROUND_HALF_EVEN mode and the result is correctly rounded." ilk="function" name="exp" signature="exp([context])" />
        <scope doc="Return the negation of the argument. This operation&#10;isunaffected by the context and is quiet: no flags are&#10;changed and no rounding is performed." ilk="function" name="copy_negate" signature="copy_negate()" />
        <scope doc="Return the largest number representable in the givencontext&#10;(or in the current default context if no context is given)&#10;that is smaller than the given operand." ilk="function" name="next_minus" signature="next_minus([context])" />
        <scope ilk="function" name="__deepcopy__" />
        <scope doc="Test whether self and other have thesame exponent or whether&#10;both are NaN." ilk="function" name="same_quantum" signature="same_quantum(other[, context])" />
        <scope ilk="function" name="__trunc__" />
        <scope doc="x.__sub__(y) &lt;==&gt; x-y" ilk="function" name="__sub__" signature="x.__sub__(y) &lt;==&gt; x-y" />
        <scope doc="Return True if the argument is a finite number, and False if&#10;theargument is infinite or a NaN." ilk="function" name="is_finite" signature="is_finite()" />
        <scope ilk="function" name="__reduce__" />
        <scope doc="x.__rfloordiv__(y) &lt;==&gt; y//x" ilk="function" name="__rfloordiv__" signature="x.__rfloordiv__(y) &lt;==&gt; y//x" />
