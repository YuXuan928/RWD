      <scope classrefs="Widget" doc="Scale widget which can display a numerical scale." ilk="class" name="Scale">
        <scope doc="Set the value to VALUE." ilk="function" name="set" signature="set(self, value)" />
        <scope doc="Get the current value as integer or float." ilk="function" name="get" signature="get(self)" />
        <scope doc="Return a tuple (X,Y) of the point along the centerline of&#10;thetrough that corresponds to VALUE or the current value if&#10;None is given." ilk="function" name="coords" signature="coords(self, value=None)" />
        <scope doc="Return where the point X,Y lies. Valid return values are&#10;&quot;slider&quot;,&quot;though1&quot; and &quot;though2&quot;." ilk="function" name="identify" signature="identify(self, x, y)" />
        <scope doc="Construct a scale widget with the parent MASTER." ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
      </scope>
      <scope classrefs="Widget" doc="Scrollbar widget which displays a slider at a certain position." ilk="class" name="Scrollbar">
        <scope doc="Set the fractional values of the slider position (upper&#10;andlower ends as value between 0 and 1)." ilk="function" name="set" signature="set(self, *args)" />
        <scope doc="Return the fractional value which corresponds to a&#10;sliderposition of X,Y." ilk="function" name="fraction" signature="fraction(self, x, y)" />
        <scope doc="Return the fractional change of the scrollbar setting if&#10;itwould be moved by DELTAX or DELTAY pixels." ilk="function" name="delta" signature="delta(self, deltax, deltay)" />
        <scope doc="Return the element under position X,Y as one&#10;of&quot;arrow1&quot;,&quot;slider&quot;,&quot;arrow2&quot; or &quot;&quot;." ilk="function" name="identify" signature="identify(self, x, y)" />
        <scope doc="Display the element at INDEX with activebackground and&#10;activerelief.INDEX can be &quot;arrow1&quot;,&quot;slider&quot; or &quot;arrow2&quot;." ilk="function" name="activate" signature="activate(self, index)" />
        <scope doc="Construct a scrollbar widget with the parent MASTER." ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
        <scope doc="Return the current fractional values (upper and lower end)of&#10;the slider position." ilk="function" name="get" signature="get(self)" />
      </scope>
      <scope classrefs="Widget XView" doc="spinbox widget." ilk="class" name="Spinbox">
        <scope doc="Internal function." ilk="function" name="selection" signature="selection(self, *args)" />
        <scope doc="Internal function." ilk="function" name="scan" signature="scan(self, *args)" />
        <scope doc="Clear the selection If the selection isn't in this widget&#10;then the command has no effect." ilk="function" name="selection_clear" signature="selection_clear(self)" />
        <scope doc="Insert string s at index Returns an empty string." ilk="function" name="insert" signature="insert(self, index, s)" />
        <scope doc="Causes the specified element to be invoked The element could&#10;be buttondown or buttonup triggering the action associated&#10;with it." ilk="function" name="invoke" signature="invoke(self, element)" />
        <scope doc="Compute the difference between the given x argumentand the x&#10;argument to the last scan mark command  It then adjusts the&#10;view left or right by 10 times the difference in&#10;x-coordinates. This command is typically associated with&#10;mouse motion events in the widget, to produce the effect of&#10;dragging the spinbox at high speed through the window." ilk="function" name="scan_dragto" signature="scan_dragto(self, x)" />
        <scope doc="Return a tuple of X1,Y1,X2,Y2 coordinates for arectangle&#10;which encloses the character given by index. The first two&#10;elements of the list give the x and y coordinates of the&#10;upper-left corner of the screen area covered by the&#10;character (in pixels relative to the widget) and the last&#10;two elements give the width and height of the character, in&#10;pixels." ilk="function" name="bbox" signature="bbox(self, index)" />
        <scope doc="Sets or gets the currently selected element." ilk="function" name="selection_element" signature="selection_element(self, element=None)" />
        <scope doc="Returns the spinbox's string" ilk="function" name="get" signature="get(self)" />
        <scope doc="Returns the numerical index corresponding to index" ilk="function" name="index" signature="index(self, index)" />
        <scope doc="Delete one or more elements of the spinbox." ilk="function" name="delete" signature="delete(self, first, last=None)" />
        <scope doc="Construct a spinbox widget with the parent MASTER." ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
        <scope doc="Locate the end of the selection nearest to the&#10;charactergiven by index,  Then adjust that end of the&#10;selection to be at index (i.e including but not going beyond&#10;index). The other end of the selection is made the anchor&#10;point for future select to commands." ilk="function" name="selection_adjust" signature="selection_adjust(self, index)" />
        <scope doc="Returns the name of the widget at position x, y Return value&#10;is one of: none, buttondown, buttonup, entry" ilk="function" name="identify" signature="identify(self, x, y)" />
        <scope doc="Alter the position of the insertion cursor." ilk="function" name="icursor" signature="icursor(self, index)" />
        <scope doc="Records x and the current view in the spinbox window; used&#10;in conjunction with later scan dragto commands." ilk="function" name="scan_mark" signature="scan_mark(self, x)" />
      </scope>
      <scope classrefs="Variable" doc="Value holder for strings variables." ilk="class" name="StringVar">
        <scope doc="Return value of variable as string." ilk="function" name="get" signature="get(self)" />
        <scope doc="Construct a string variable." ilk="function" name="__init__" signature="__init__(self, master=None, value=None, name=None)" />
      </scope>
      <scope classrefs="Button" ilk="class" name="Studbutton">
        <scope ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
      </scope>
      <variable citdl="str" name="TOP" />
      <variable citdl="int" name="TRUE" />
      <scope ilk="function" name="Tcl" signature="Tcl(screenName=None, baseName=None, className='Tk', useTk=0)" />
      <scope classrefs="Exception" ilk="class" name="TclError" />
      <variable citdl="float" name="TclVersion" />
      <scope classrefs="Widget XView YView" doc="Text widget which can display text in various forms." ilk="class" name="Text">
        <scope doc="Return the value of OPTION of an embedded image at INDEX." ilk="function" name="image_cget" signature="image_cget(self, index, option)" />
        <scope doc="Clears the undo and redo stacks" ilk="function" name="edit_reset" signature="edit_reset(self)" />
        <scope doc="Adjust the view of the text to 10 times thedifference&#10;between X and Y and the coordinates given in scan_mark." ilk="function" name="scan_dragto" signature="scan_dragto(self, x, y)" />
        <scope doc="Return the name of the next mark after INDEX." ilk="function" name="mark_next" signature="mark_next(self, index)" />
        <scope doc="Remember the current X, Y coordinates." ilk="function" name="scan_mark" signature="scan_mark(self, x, y)" />
        <scope doc="Insert CHARS before the characters at INDEX. An&#10;additionaltag can be given in ARGS." ilk="function" name="insert" signature="insert(self, index, chars, *args)" />
        <scope doc="Change the priority of tag TAGNAME such that it is lowerthan&#10;the priority of BELOWTHIS." ilk="function" name="tag_lower" signature="tag_lower(self, tagName, belowThis=None)" />
        <scope doc="Return the name of the previous mark before INDEX." ilk="function" name="mark_previous" signature="mark_previous(self, index)" />
        <scope doc="Return a tuple of (x,y,width,height) which gives the&#10;boundingbox of the visible part of the character at the&#10;index in ARGS." ilk="function" name="bbox" signature="bbox(self, *args)" />
        <scope doc="Change the gravity of a mark MARKNAME to DIRECTION (LEFT or&#10;RIGHT).Return the current value if None is given for&#10;DIRECTION." ilk="function" name="mark_gravity" signature="mark_gravity(self, markName, direction=None)" />
        <scope doc="Delete all tags in TAGNAMES." ilk="function" name="tag_delete" signature="tag_delete(self, *tagNames)" />
        <scope doc="Return the value of OPTION of an embedded window at INDEX." ilk="function" name="window_cget" signature="window_cget(self, index, option)" />
        <scope doc="Return a list of start and end index for the first sequence&#10;ofcharacters between INDEX1 and INDEX2 which all have tag&#10;TAGNAME. The text is searched backwards from INDEX1." ilk="function" name="tag_prevrange" signature="tag_prevrange(self, tagName, index1, index2=None)" />
        <scope doc="Inserts a separator (boundary) on the undo stack." ilk="function" name="edit_separator" signature="edit_separator(self)" />
        <scope doc="Counts the number of relevant things between the two&#10;indices.If index1 is after index2, the result will be a&#10;negative number (and this holds for each of the possible&#10;options). The actual items which are counted depends on the&#10;options given by args." ilk="function" name="count" signature="count(self, index1, index2, *args)" />
        <scope doc="Get or Set the modified flag If arg is not specified,&#10;returns the modified flag of the widget." ilk="function" name="edit_modified" signature="edit_modified(self, arg=None)" />
        <scope ilk="function" name="tk_textSelectTo" signature="tk_textSelectTo(self, index)" />
        <scope doc="Undoes the last edit action If the undo option is true." ilk="function" name="edit_undo" signature="edit_undo(self)" />
        <scope doc="Return the index in the form line.char for INDEX." ilk="function" name="index" signature="index(self, index)" />
        <scope doc="Delete the characters between INDEX1 and INDEX2 (not&#10;included)." ilk="function" name="delete" signature="delete(self, index1, index2=None)" />
        <scope doc="Configure an embedded window at INDEX." ilk="function" name="window_config" signature="window_config(self, index, cnf=None, **kw)" />
        <scope doc="Search PATTERN beginning from INDEX until STOPINDEX.Return&#10;the index of the first character of a match or an empty&#10;string." ilk="function" name="search" signature="search(self, pattern, index, stopindex=None, forwards=None, backwards=None, exact=None, regexp=None, nocase=None, count=None, elide=None)" />
        <scope ilk="function" name="tk_textResetAnchor" signature="tk_textResetAnchor(self, index)" />
        <scope doc="Internal method This method controls the undo mechanism and&#10;the modified flag." ilk="function" name="edit" signature="edit(self, *args)" />
        <scope ilk="function" name="tk_textBackspace" signature="tk_textBackspace(self)" />
        <scope doc="Return all names of embedded images in this widget." ilk="function" name="image_names" signature="image_names(self)" />
        <scope doc="Return the contents of the widget between index1 and index2." ilk="function" name="dump" signature="dump(self, index1, index2=None, command=None, **kw)" />
        <scope doc="Configure a tag TAGNAME." ilk="function" name="tag_config" signature="tag_config(self, tagName, cnf=None, **kw)" />
        <scope doc="Configure a tag TAGNAME." ilk="function" name="tag_configure" signature="tag_configure(self, tagName, cnf=None, **kw)" />
        <scope doc="Return a list of ranges of text which have tag TAGNAME." ilk="function" name="tag_ranges" signature="tag_ranges(self, tagName)" />
        <scope doc="Return all names of embedded windows in this widget." ilk="function" name="window_names" signature="window_names(self)" />
        <scope doc="Return the value of OPTION for tag TAGNAME." ilk="function" name="tag_cget" signature="tag_cget(self, tagName, option)" />
        <scope doc="Add tag TAGNAME to all characters between INDEX1 and index2&#10;in ARGS.Additional pairs of indices may follow in ARGS." ilk="function" name="tag_add" signature="tag_add(self, tagName, index1, *args)" />
        <scope doc="Creates a peer text widget with the given newPathName, and&#10;anyoptional standard configuration options. By default the&#10;peer will have the same start and and end line as the parent&#10;widget, but these can be overriden with the standard&#10;configuration options." ilk="function" name="peer_create" signature="peer_create(self, newPathName, cnf={}, **kw)" />
        <scope doc="Redo the last undone edit When the undo option is true,&#10;reapplies the last undone edits provided no other edits were&#10;done since then." ilk="function" name="edit_redo" signature="edit_redo(self)" />
        <scope doc="Replaces the range of characters between index1 and index2&#10;withthe given characters and tags specified by args. See the&#10;method insert for some more information about args, and the&#10;method delete for information about the indices." ilk="function" name="replace" signature="replace(self, index1, index2, chars, *args)" />
        <scope doc="Returns a list of peers of this widget (this does not&#10;includethe widget itself)." ilk="function" name="peer_names" signature="peer_names(self)" />
        <scope doc="Return all mark names." ilk="function" name="mark_names" signature="mark_names(self)" />
        <scope ilk="function" name="tk_textIndexCloser" signature="tk_textIndexCloser(self, a, b, c)" />
        <scope doc="Return a list of all tag names." ilk="function" name="tag_names" signature="tag_names(self, index=None)" />
        <scope doc="Configure an embedded image at INDEX." ilk="function" name="image_configure" signature="image_configure(self, index, cnf=None, **kw)" />
        <scope doc="Scroll such that the character at INDEX is visible." ilk="function" name="see" signature="see(self, index)" />
        <scope doc="Configure an embedded window at INDEX." ilk="function" name="window_configure" signature="window_configure(self, index, cnf=None, **kw)" />
        <scope doc="Obsolete function, use see." ilk="function" name="yview_pickplace" signature="yview_pickplace(self, *what)" />
        <scope doc="Bind to all characters with TAGNAME at event SEQUENCE a call&#10;to function FUNC." ilk="function" name="tag_bind" signature="tag_bind(self, tagName, sequence, func, add=None)" />
        <scope doc="Construct a text widget with the parent MASTER." ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
        <scope doc="Create an embedded image at INDEX." ilk="function" name="image_create" signature="image_create(self, index, cnf={}, **kw)" />
        <scope doc="Unbind for all characters with TAGNAME for event SEQUENCE&#10;thefunction identified with FUNCID." ilk="function" name="tag_unbind" signature="tag_unbind(self, tagName, sequence, funcid=None)" />
        <scope doc="Set mark MARKNAME before the character at INDEX." ilk="function" name="mark_set" signature="mark_set(self, markName, index)" />
        <scope doc="Return the text from INDEX1 to INDEX2 (not included)." ilk="function" name="get" signature="get(self, index1, index2=None)" />
        <scope doc="Return a list of start and end index for the first sequence&#10;ofcharacters between INDEX1 and INDEX2 which all have tag&#10;TAGNAME. The text is searched forward from INDEX1." ilk="function" name="tag_nextrange" signature="tag_nextrange(self, tagName, index1, index2=None)" />
        <scope doc="Create a window at INDEX." ilk="function" name="window_create" signature="window_create(self, index, cnf={}, **kw)" />
        <scope doc="Return whether between index INDEX1 and index INDEX2&#10;therelation OP is satisfied. OP is one of &lt;, &lt;=, ==, &gt;=, &gt;,&#10;or !=." ilk="function" name="compare" signature="compare(self, index1, op, index2)" />
        <scope doc="Change the priority of tag TAGNAME such that it is&#10;higherthan the priority of ABOVETHIS." ilk="function" name="tag_raise" signature="tag_raise(self, tagName, aboveThis=None)" />
        <scope doc="Turn on the internal consistency checks of the B-Tree inside&#10;the textwidget according to BOOLEAN." ilk="function" name="debug" signature="debug(self, boolean=None)" />
        <scope doc="Return tuple (x,y,width,height,baseline) giving the bounding&#10;boxand baseline position of the visible part of the line&#10;containing the character at INDEX." ilk="function" name="dlineinfo" signature="dlineinfo(self, index)" />
        <scope doc="Delete all marks in MARKNAMES." ilk="function" name="mark_unset" signature="mark_unset(self, *markNames)" />
        <scope doc="Remove tag TAGNAME from all characters between INDEX1 and&#10;INDEX2." ilk="function" name="tag_remove" signature="tag_remove(self, tagName, index1, index2=None)" />
      </scope>
      <scope classrefs="Misc Wm" doc="Toplevel widget of Tk which represents mostly the main windowof an application. It has an associated Tcl interpreter." ilk="class" name="Tk">
        <scope ilk="function" name="_loadtk" signature="_loadtk(self)" />
        <scope doc="Internal function. It reads BASENAME.tcl and CLASSNAME.tcl&#10;intothe Tcl Interpreter and calls exec on the contents of&#10;BASENAME.py and CLASSNAME.py if such a file exists in the&#10;home directory." ilk="function" name="readprofile" signature="readprofile(self, baseName, className)" />
        <scope doc="Destroy this and all descendants widgets. This willend the&#10;application of this Tcl interpreter." ilk="function" name="destroy" signature="destroy(self)" />
        <scope doc="Return a new Toplevel widget on screen SCREENNAME. A new Tcl&#10;interpreter willbe created." ilk="function" name="__init__" signature="__init__(self, screenName=None, baseName=None, className='Tk', useTk=1, sync=0, use=None)" />
        <scope doc="Internal function. It reports exception on sys.stderr." ilk="function" name="report_callback_exception" signature="report_callback_exception(self, exc, val, tb)" />
        <scope doc="Delegate attribute access to the interpreter object" ilk="function" name="__getattr__" signature="__getattr__(self, attr)" />
        <scope ilk="function" name="loadtk" signature="loadtk(self)" />
      </scope>
      <variable citdl="float" name="TkVersion" />
      <scope classrefs="BaseWidget Wm" doc="Toplevel widget, e.g. for dialogs." ilk="class" name="Toplevel">
        <scope doc="Construct a toplevel widget with the parent MASTER." ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
      </scope>
      <scope classrefs="Button" ilk="class" name="Tributton">
        <scope ilk="function" name="__init__" signature="__init__(self, master=None, cnf={}, **kw)" />
      </scope>
      <variable citdl="str" name="UNDERLINE" />
      <variable citdl="str" name="UNITS" />
      <variable citdl="str" name="VERTICAL" />
      <scope classrefs="object" doc="Class to define value holders for e.g. buttons.&#10;Subclasses StringVar, IntVar, DoubleVar, BooleanVar are specializations that constrain the type of the value returned from get()." ilk="class" name="Variable">
        <scope doc="Set the variable to VALUE." ilk="function" name="set" signature="set(self, value)" />
        <scope doc="Set the variable to VALUE." ilk="function" name="initialize" signature="initialize(self, value)" />
        <scope doc="Return all trace callback information." ilk="function" name="trace_vinfo" signature="trace_vinfo(self)" />
        <scope doc="Comparison for equality (==)." ilk="function" name="__eq__" signature="__eq__(self, other)" />
        <scope doc="Construct a variable MASTER can be given as master widget." ilk="function" name="__init__" signature="__init__(self, master=None, value=None, name=None)" />
        <scope doc="Return value of variable." ilk="function" name="get" signature="get(self)" />
        <scope doc="Define a trace callback for the variable." ilk="function" name="trace_variable" signature="trace_variable(self, mode, callback)" />
        <scope doc="Delete the trace callback for a variable." ilk="function" name="trace_vdelete" signature="trace_vdelete(self, mode, cbname)" />
        <scope doc="Define a trace callback for the variable." ilk="function" name="trace" signature="trace(self, mode, callback)" />
        <scope doc="Return the name of the variable in Tcl." ilk="function" name="__str__" signature="__str__(self)" />
        <scope doc="Unset the variable in Tcl." ilk="function" name="__del__" signature="__del__(self)" />
      </scope>
      <variable citdl="str" name="W" />
      <variable citdl="str" name="WORD" />
      <variable citdl="int" name="WRITABLE" />
      <scope classrefs="BaseWidget Pack Place Grid Form" doc="Internal class.&#10;Base class for a widget which can be positioned with the geometry managers Pack, Place or Grid." ilk="class" name="Widget" />
      <scope classrefs="object" doc="Provides functions for the communication with the window manager." ilk="class" name="Wm">
        <scope doc="Instruct the window manager that the size of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="sizefrom" signature="sizefrom(self, who=None)" />
        <scope doc="Instruct the window manager that the position of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="positionfrom" signature="positionfrom(self, who=None)" />
        <scope doc="Set the title of this widget." ilk="function" name="title" signature="title(self, string=None)" />
        <scope doc="Instruct the window manager that this widget is&#10;transientwith regard to widget MASTER." ilk="function" name="transient" signature="transient(self, master=None)" />
        <scope doc="Set bitmap for the iconified widget to BITMAP. Returnthe&#10;bitmap if None is given." ilk="function" name="iconbitmap" signature="iconbitmap(self, bitmap=None, default=None)" />
        <scope doc="Query or set the state of this widget as one of normal,&#10;icon,iconic (see wm_iconwindow), withdrawn, or zoomed&#10;(Windows only)." ilk="function" name="state" signature="state(self, newstate=None)" />
        <scope doc="Instruct the window manager that this widget shall only&#10;beresized on grid boundaries. WIDTHINC and HEIGHTINC are the&#10;width and height of a grid unit in pixels." ilk="function" name="wm_grid" signature="wm_grid(self, baseWidth=None, baseHeight=None, widthInc=None, heightInc=None)" />
        <scope doc="Set the name of the icon for this widget. Return the name&#10;ifNone is given." ilk="function" name="wm_iconname" signature="wm_iconname(self, newName=None)" />
        <scope doc="Store NAME in WM_CLIENT_MACHINE property of this widget.&#10;Returncurrent value." ilk="function" name="wm_client" signature="wm_client(self, name=None)" />
        <scope doc="Display widget as icon." ilk="function" name="iconify" signature="iconify(self)" />
        <scope doc="Set focus model to MODEL. &quot;active&quot; means that this widget&#10;will claimthe focus itself, &quot;passive&quot; means that the window&#10;manager shall give the focus." ilk="function" name="wm_focusmodel" signature="wm_focusmodel(self, model=None)" />
        <scope doc="Set the title of this widget." ilk="function" name="wm_title" signature="wm_title(self, string=None)" />
        <scope doc="Instruct the window manager to ignore this widgetif BOOLEAN&#10;is given with 1. Return the current value if None is given." ilk="function" name="overrideredirect" signature="overrideredirect(self, boolean=None)" />
        <scope doc="Store NAME in WM_CLIENT_MACHINE property of this widget.&#10;Returncurrent value." ilk="function" name="client" signature="client(self, name=None)" />
        <scope doc="The widget specified will become a stand alone top-level&#10;window.The window will be decorated with the window managers&#10;title bar, etc." ilk="function" name="manage" signature="manage(self, widget)" />
        <scope doc="Deiconify this widget. If it was never mapped it will not be&#10;mapped.On Windows it will raise this widget and give it the&#10;focus." ilk="function" name="deiconify" signature="deiconify(self)" />
        <scope doc="Store VALUE in WM_COMMAND property. It is the commandwhich&#10;shall be used to invoke the application." ilk="function" name="wm_command" signature="wm_command(self, value=None)" />
        <scope doc="Instruct the window manager that this widget is&#10;transientwith regard to widget MASTER." ilk="function" name="wm_transient" signature="wm_transient(self, master=None)" />
        <scope doc="Sets the titlebar icon for this window based on the named&#10;photoimages passed through args. If default is True, this is&#10;applied to all future created toplevels as well." ilk="function" name="wm_iconphoto" signature="wm_iconphoto(self, default=False, *args)" />
        <scope doc="Set min WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="wm_minsize" signature="wm_minsize(self, width=None, height=None)" />
        <scope doc="Set bitmap for the iconified widget to BITMAP. Returnthe&#10;bitmap if None is given." ilk="function" name="wm_iconbitmap" signature="wm_iconbitmap(self, bitmap=None, default=None)" />
        <scope doc="Set mask for the icon bitmap of this widget. Return themask&#10;if None is given." ilk="function" name="wm_iconmask" signature="wm_iconmask(self, bitmap=None)" />
        <scope doc="The window will be unmappend from the screen and will no&#10;longerbe managed by wm. toplevel windows will be treated&#10;like frame windows once they are no longer managed by wm,&#10;however, the menu option configuration will be remembered&#10;and the menus will return once the widget is managed again." ilk="function" name="wm_forget" signature="wm_forget(self, window)" />
        <scope doc="Instruct the window manager whether this width can be&#10;resizedin WIDTH or HEIGHT. Both values are boolean values." ilk="function" name="wm_resizable" signature="wm_resizable(self, width=None, height=None)" />
        <scope doc="Store list of window names (WLIST) into WM_COLORMAPWINDOWS&#10;propertyof this widget. This list contains windows whose&#10;colormaps differ from their parents." ilk="function" name="colormapwindows" signature="colormapwindows(self, *wlist)" />
        <scope doc="Deiconify this widget. If it was never mapped it will not be&#10;mapped.On Windows it will raise this widget and give it the&#10;focus." ilk="function" name="wm_deiconify" signature="wm_deiconify(self)" />
        <scope doc="Store VALUE in WM_COMMAND property. It is the commandwhich&#10;shall be used to invoke the application." ilk="function" name="command" signature="command(self, value=None)" />
        <scope doc="Return identifier for decorative frame of this widget if&#10;present." ilk="function" name="wm_frame" signature="wm_frame(self)" />
        <scope doc="Instruct the window manager that this widget shall only&#10;beresized on grid boundaries. WIDTHINC and HEIGHTINC are the&#10;width and height of a grid unit in pixels." ilk="function" name="grid" signature="grid(self, baseWidth=None, baseHeight=None, widthInc=None, heightInc=None)" />
        <scope doc="Display widget as icon." ilk="function" name="wm_iconify" signature="wm_iconify(self)" />
        <scope doc="Store list of window names (WLIST) into WM_COLORMAPWINDOWS&#10;propertyof this widget. This list contains windows whose&#10;colormaps differ from their parents." ilk="function" name="wm_colormapwindows" signature="wm_colormapwindows(self, *wlist)" />
        <scope doc="Instruct the window manager that the size of this widget&#10;shallbe defined by the user if WHO is &quot;user&quot;, and by its own&#10;policy if WHO is &quot;program&quot;." ilk="function" name="wm_sizefrom" signature="wm_sizefrom(self, who=None)" />
        <scope doc="Set geometry to NEWGEOMETRY of the form =widthxheight+x+y.&#10;Returncurrent value if None is given." ilk="function" name="geometry" signature="geometry(self, newGeometry=None)" />
        <scope doc="Withdraw this widget from the screen such that it is&#10;unmappedand forgotten by the window manager. Re-draw it with&#10;wm_deiconify." ilk="function" name="wm_withdraw" signature="wm_withdraw(self)" />
        <scope doc="This subcommand returns or sets platform specific attributes&#10;The first form returns a list of the platform specific flags&#10;and their values." ilk="function" name="attributes" signature="attributes(self, *args)" />
        <scope doc="Set widget PATHNAME to be displayed instead of icon. Return&#10;the currentvalue if None is given." ilk="function" name="iconwindow" signature="iconwindow(self, pathName=None)" />
        <scope doc="Set the group leader widgets for related widgets to&#10;PATHNAME. Returnthe group leader of this widget if None is&#10;given." ilk="function" name="wm_group" signature="wm_group(self, pathName=None)" />
        <scope doc="Bind function FUNC to command NAME for this widget.Return&#10;the function bound to NAME if None is given. NAME could be&#10;e.g." ilk="function" name="wm_protocol" signature="wm_protocol(self, name=None, func=None)" />
        <scope doc="This subcommand returns or sets platform specific attributes&#10;The first form returns a list of the platform specific flags&#10;and their values." ilk="function" name="wm_attributes" signature="wm_attributes(self, *args)" />
        <scope doc="Set max WIDTH and HEIGHT for this widget. If the window is&#10;griddedthe values are given in grid units." ilk="function" name="wm_maxsize" signature="wm_maxsize(self, width=None, height=None)" />
        <scope doc="Set widget PATHNAME to be displayed instead of icon. Return&#10;the currentvalue if None is given." ilk="function" name="wm_iconwindow" signature="wm_iconwindow(self, pathName=None)" />
        <scope doc="Instruct the window manager whether this width can be&#10;resizedin WIDTH or HEIGHT. Both values are boolean values." ilk="function" name="resizable" signature="resizable(self, width=None, height=None)" />
        <scope doc="Instruct the window manager to set the aspect ratio&#10;(width/height)of this widget to be between MINNUMER/MINDENOM&#10;and MAXNUMER/MAXDENOM. Return a tuple of the actual values&#10;if no argument is given." ilk="function" name="wm_aspect" signature="wm_aspect(self, minNumer=None, minDenom=None, maxNumer=None, maxDenom=None)" />
        <scope doc="Set the name of the icon for this widget. Return the name&#10;ifNone is given." ilk="function" name="iconname" signature="iconname(self, newName=None)" />
        <scope doc="Set the group leader widgets for related widgets to&#10;PATHNAME. Returnthe group leader of this widget if None is&#10;given." ilk="function" name="group" signature="group(self, pathName=None)" />
