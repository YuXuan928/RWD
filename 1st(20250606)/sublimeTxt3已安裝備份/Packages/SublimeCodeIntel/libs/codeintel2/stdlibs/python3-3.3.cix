      <scope doc="Create a FIFO (a POSIX named pipe)." ilk="function" name="mkfifo" signature="mkfifo(path, mode=0o666, *, dir_fd=None)" />
      <scope doc="Create a filesystem node (file, device special file or named&#10;pipe) named filename." ilk="function" name="mknod" signature="mknod(filename, mode=0o600, device=0, *, dir_fd=None)" />
      <scope doc="Decrease the priority of process by inc and return the new&#10;priority." ilk="function" name="nice" signature="nice(inc) -&gt; new_priority" />
      <scope doc="Open a file for low level IO." ilk="function" name="open" signature="open(path, flags, mode=0o777, *, dir_fd=None)" />
      <scope doc="Open a pseudo-terminal, returning open fd's for both master&#10;and slave end." ilk="function" name="openpty" signature="openpty() -&gt; (master_fd, slave_fd)" />
