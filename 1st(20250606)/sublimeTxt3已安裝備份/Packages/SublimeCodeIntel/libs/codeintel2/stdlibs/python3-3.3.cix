      <scope doc="Announces an intention to access data in a specific pattern&#10;thus allowing the kernel to make optimizations." ilk="function" name="posix_fadvise" signature="posix_fadvise(fd, offset, len, advice)" />
      <scope doc="Ensures that enough disk space is allocated for the file&#10;specified by fd starting from offset and continuing for len&#10;bytes." ilk="function" name="posix_fallocate" signature="posix_fallocate(fd, offset, len)" />
