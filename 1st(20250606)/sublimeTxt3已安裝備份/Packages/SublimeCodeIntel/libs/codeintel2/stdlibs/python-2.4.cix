        <scope doc="(if E has keys else: for (k, v) in E: D[k] = v) then: for k&#xA;in F: D[k] = F[k]" ilk="function" name="update" signature="D.update(E, **F) -&gt; None.  Update D from E and F: for k in E: D[k] = E[k]" />
        <scope doc="x.__setitem__(i, y) &lt;==&gt; x[i]=y" ilk="function" name="__setitem__" signature="x.__setitem__(i, y) &lt;==&gt; x[i]=y" />
