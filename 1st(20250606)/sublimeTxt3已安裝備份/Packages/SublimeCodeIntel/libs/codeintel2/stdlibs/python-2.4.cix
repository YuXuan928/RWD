    <scope doc="# This module should be kept compatible with Python 2.1." ilk="blob" lang="Python" name="distutils.command.install_lib">
      <scope doc="Abstract base class for defining command classes, the &quot;worker bees&quot;&#xA;of the Distutils.  A useful analogy for command classes is to think of&#xA;them as subroutines with local variables called &quot;options&quot;.  The options" ilk="class" name="Command">
        <scope ilk="function" name="_ensure_tested_string" />
