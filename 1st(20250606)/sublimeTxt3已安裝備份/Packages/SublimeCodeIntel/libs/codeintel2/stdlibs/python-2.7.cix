        <scope doc="x.__delattr__('name') &lt;==&gt; del x.name" ilk="function" name="__delattr__" signature="x.__delattr__('name') &lt;==&gt; del x.name" />
        <scope doc="Return tuple containing values unpacked according to this&#10;Struct's format." ilk="function" name="unpack_from" signature="S.unpack_from(buffer[, offset]) -&gt; (v1, v2, ...)" />
        <scope doc="Return tuple containing values unpacked according to this&#10;Struct's format." ilk="function" name="unpack" signature="S.unpack(str) -&gt; (v1, v2, ...)" />
        <scope ilk="function" name="__init__" />
        <scope doc="Return a string containing values v1, v2, ..." ilk="function" name="pack" returns="str" signature="S.pack(v1, v2, ...) -&gt; string" />
