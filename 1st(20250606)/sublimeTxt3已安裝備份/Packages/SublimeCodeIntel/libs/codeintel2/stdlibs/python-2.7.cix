        <scope doc="Return a tuple of column and row which identify the cell at&#10;which the pixel at position X and Y inside the master widget&#10;is located." ilk="function" name="grid_location" />
        <scope doc="Set or get the status for propagation of geometry&#10;information." ilk="function" name="propagate" />
