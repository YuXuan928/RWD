    <scope doc="This module provides access to the Unix password database.&#10;It is available on all Unix versions.  Password database entries are reported as 7-tuples containing the following items from the password database (see `&lt;pwd.h&gt;'), in order: pw_name, pw_passwd, pw_uid, pw_gid, pw_gecos, pw_dir, pw_shell. The uid and gid items are integers, all others are strings. An exception is raised if the entry asked for cannot be found." ilk="blob" lang="Python" name="pwd">
      <scope doc="Return a list of all available password database entries, in&#10;arbitrary order." ilk="function" name="getpwall" signature="getpwall() -&gt; list_of_entries" />
      <scope doc="pw_gid,pw_gecos,pw_dir,pw_shell) Return the password&#10;database entry for the given user name." ilk="function" name="getpwnam" signature="getpwnam(name) -&gt; (pw_name,pw_passwd,pw_uid," />
      <scope doc="pw_gid,pw_gecos,pw_dir,pw_shell) Return the password&#10;database entry for the given numeric user ID." ilk="function" name="getpwuid" signature="getpwuid(uid) -&gt; (pw_name,pw_passwd,pw_uid," />
      <scope classrefs="object" doc="pwd.struct_passwd: Results from getpw*() routines.&#10;This object may be accessed either as a tuple of (pw_name,pw_passwd,pw_uid,pw_gid,pw_gecos,pw_dir,pw_shell) or via the object attributes as named in the above tuple." ilk="class" name="struct_passwd">
        <scope doc="Use of negative indices is not supported." ilk="function" name="__getslice__" signature="x.__getslice__(i, j) &lt;==&gt; x[i:j]" />
        <scope ilk="function" name="__reduce__" />
        <scope doc="x.__rmul__(n) &lt;==&gt; n*x" ilk="function" name="__rmul__" signature="x.__rmul__(n) &lt;==&gt; n*x" />
