    <scope doc="This module contains functions for accessing NIS maps. " ilk="blob" lang="Python" name="nis">
      <scope doc="Returns the entire map as a dictionary." ilk="function" name="cat" signature="cat(map, domain = defaultdomain)" />
      <scope classrefs="Exception" doc=" " ilk="class" name="error" />
      <scope doc="Corresponds to the C library yp_get_default_domain() call, returning the default NIS domain." ilk="function" name="get_default_domain" returns="str" signature="get_default_domain() -&gt; str" />
      <scope doc="Returns an array of all available NIS maps within a domain." ilk="function" name="maps" signature="maps(domain = defaultdomain)" />
      <scope doc="Corresponds to the C library yp_match() call, returning the value of key in the given map." ilk="function" name="match" signature="match(key, map, domain = defaultdomain)" />
    </scope>
    <scope doc="This module provides an interface to the Posix calls for tty I/O control. For a complete description of these calls, see the Posix or Unix manual pages. It is only available for those Unix versions that support Posix termios style tty I/O control.  All functions in this module take a file descriptor fd as their first argument. This can be an integer file descriptor, such as returned by sys.stdin.fileno(), or a file object, such as sys.stdin itself." ilk="blob" lang="Python" name="termios">
