      <scope classrefs="Widget" doc="Entry widget which allows to display simple text. " ilk="class" name="Entry">
        <scope doc="Remember the current X, Y coordinates." ilk="function" name="scan_mark" />
        <scope doc="Shift the x-view according to NUMBER which is measured in &quot;units&quot; or &quot;pages&quot; (WHAT)." ilk="function" name="xview_scroll" />
        <scope doc="Set the fixed end of a selection to INDEX." ilk="function" name="selection_from" />
        <scope doc="Adjust the view of the canvas to 10 times the difference between X and Y and the coordinates given in scan_mark." ilk="function" name="scan_dragto" />
        <scope doc="Adjust the view in the window so that FRACTION of the total width of the entry is off-screen to the left." ilk="function" name="xview_moveto" />
        <scope doc="Clear the selection if it is in this widget." ilk="function" name="selection_clear" />
        <scope doc="Set the fixed end of a selection to INDEX." ilk="function" name="select_from" />
