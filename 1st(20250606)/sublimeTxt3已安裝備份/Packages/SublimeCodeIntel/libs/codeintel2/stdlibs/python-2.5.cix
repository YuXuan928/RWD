    <scope doc="This module provides access to the garbage collector for reference cycles. enable() -- Enable automatic garbage collection. disable() -- Disable automatic garbage collection. isenabled() -- Returns true if automatic collection is enabled. collect() -- Do a full collection right now. get_count() -- Return the current collection counts. set_debug() -- Set debugging flags. get_debug() -- Get debugging flags. set_threshold() -- Set the collection thresholds. get_threshold() -- Return the current the collection thresholds. get_objects() -- Return a list of all objects tracked by the collector." ilk="blob" lang="Python" name="gc">
      <variable citdl="int" name="DEBUG_COLLECTABLE" />
      <variable citdl="int" name="DEBUG_INSTANCES" />
