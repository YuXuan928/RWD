      <scope classrefs="object" doc="tuple() -&gt; an empty tuple tuple(sequence) -&gt; tuple initialized from sequence&apos;s items  If the argument is a tuple, the return value is the same object." ilk="class" name="TupleType">
        <scope doc="x.__ne__(y) &lt;==&gt; x!=y" ilk="function" name="__ne__" signature="x.__ne__(y) &lt;==&gt; x!=y" />
        <scope doc="Use of negative indices is not supported." ilk="function" name="__getslice__" signature="x.__getslice__(i, j) &lt;==&gt; x[i:j]" />
