        <scope doc="D.keys() -&gt; list of D&apos;s keys" ilk="function" name="keys" returns="list" signature="D.keys() -&gt; list of D&apos;s keys" />
        <scope doc="(if E has keys else: for (k, v) in E: D[k] = v) then: for k in F: D[k] = F[k]" ilk="function" name="update" signature="D.update(E, **F) -&gt; None.  Update D from E and F: for k in E: D[k] = E[k]" />
