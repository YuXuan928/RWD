        <scope doc="Return a list of all slaves of this widget in its packing order." ilk="function" name="slaves" />
        <scope doc="Return a tuple of column and row which identify the cell at which the pixel at position X and Y inside the master widget is located." ilk="function" name="grid_location" />
        <scope doc="Set or get the status for propagation of geometry information." ilk="function" name="propagate" />
        <scope doc="Configure row INDEX of a grid." ilk="function" name="rowconfigure" />
