      <scope classrefs="CCompilerError" doc="Failure to preprocess one or more C/C++ files. " ilk="class" name="PreprocessError" />
      <scope classrefs="object" doc="slice([start,] stop[, step]) Create a slice object.  This is used for extended slicing (e.g. a[0:10:2])." ilk="class" name="SliceType">
        <scope doc="x.__getattribute__(&apos;name&apos;) &lt;==&gt; x.name" ilk="function" name="__getattribute__" signature="x.__getattribute__(&apos;name&apos;) &lt;==&gt; x.name" />
